{
  "$schema": "cw-language-catalog/1",
  "name": "CW Script",
  "shortName": "Float",
  "version": "0.4.0",
  "basedOn": "CW Script（代码世界）",
  "status": "CW Script 核心语言 + 0.4 扩展：异常处理、方法链、多返回值；界面按 PyCharm 新 UI 重做",
  "fileExtension": ".cw",
  "encoding": "UTF-8",
  "lineEnding": "LF",
  "layout": {
    "mode": "line",
    "lineComment": "//",
    "lineSkip": "--",
    "semicolon": "行尾 ; 可选，匹配后忽略",
    "braces": "{ } 可选；块是否存在只由缩进决定",
    "indent": "子语句缩进必须严格大于父语句；缩进回退到父级或更浅即结束当前块",
    "blankLine": "空行忽略，不生成 AST 节点",
    "branchMerge": "else / elif 与上一块同级缩进即可；} else { / } elif (…) { 同行书写也识别"
  },
  "types": [
    "int",
    "float",
    "str",
    "bool",
    "list",
    "dict"
  ],
  "specialVariables": [
    {
      "name": "ans",
      "writtenBy": "ask",
      "note": "ask 的回答；ask 之后可直接当值使用"
    },
    {
      "name": "__last_calc",
      "writtenBy": "math_add / math_sub / math_mul / math_div / math_mod / math_pow / math_rand / math_sqrt / math_abs / math_floor / math_ceil / math_round"
    },
    {
      "name": "__last_cmp",
      "writtenBy": "cmp_lt / cmp_eq / cmp_gt / logic_and / logic_or / logic_not / list_in / dict_in / str_contain"
    },
    {
      "name": "__last_read",
      "writtenBy": "list_read / dict_read / dict_allkey / dict_allval"
    },
    {
      "name": "__last_len",
      "writtenBy": "list_len"
    },
    {
      "name": "__last_str",
      "writtenBy": "str_join / str_char / str_len"
    },
    {
      "name": "__last_time",
      "writtenBy": "time_read"
    },
    {
      "name": "__last_ans",
      "writtenBy": "ans"
    }
  ],
  "constructs": [
    {
      "ast": "for_range",
      "category": "control",
      "syntax": "for i in range(n)\nfor i in range(a, b)\nfor i in range(a, b, step)\nrepeat(n)",
      "body": true,
      "notes": "0.2 起 n 可以是任意表达式（变量、算式、函数调用）。循环变量名任意，且真正进入作用域，嵌套循环互不干扰"
    },
    {
      "ast": "for_to",
      "category": "control",
      "syntax": "for i = 1 to 10\nfor i = 10 to 1 step -1",
      "body": true,
      "notes": "含两端；左侧起点可以是表达式"
    },
    {
      "ast": "for_in",
      "category": "control",
      "syntax": "for x in 列表\nfor ch in \"字符串\"\nfor k in 字典\nfor k, v in 字典",
      "body": true,
      "notes": "列表/字符串给元素；字典默认给键，双变量形式给键与值"
    },
    {
      "ast": "main_loop",
      "category": "control",
      "syntax": "forever\nmain loop",
      "body": true
    },
    {
      "ast": "if_block",
      "category": "control",
      "syntax": "if (条件)\nif",
      "body": true,
      "notes": "省略条件按 true 处理"
    },
    {
      "ast": "elif_block",
      "category": "control",
      "syntax": "elif (条件)",
      "body": true
    },
    {
      "ast": "else",
      "category": "control",
      "syntax": "else",
      "body": true
    },
    {
      "ast": "if_elif_else",
      "category": "control",
      "syntax": "} elif (条件) {\n} else {",
      "body": true,
      "notes": "分支行与上一个 } 同行书写时合并为同一条 if 语句"
    },
    {
      "ast": "while_block",
      "category": "control",
      "syntax": "while (条件)",
      "body": true
    },
    {
      "ast": "break",
      "category": "control",
      "syntax": "break\nout",
      "body": false,
      "notes": "跳出当前循环"
    },
    {
      "ast": "continue",
      "category": "control",
      "syntax": "balo\ncontinue",
      "body": false
    },
    {
      "ast": "wait_to",
      "category": "control",
      "syntax": "wait until(条件)",
      "body": true,
      "notes": "条件为假时重复执行块，成立后继续"
    },
    {
      "ast": "if_out",
      "category": "control",
      "syntax": "if out(条件)",
      "body": false
    },
    {
      "ast": "wait",
      "category": "control",
      "syntax": "wait 0.5\nwait(表达式)",
      "body": false
    },
    {
      "ast": "stop",
      "category": "control",
      "syntax": "stop all\nstop now\nstop script",
      "body": false
    },
    {
      "ast": "return",
      "category": "function",
      "syntax": "return 表达式\nreturn",
      "body": false
    },
    {
      "ast": "var_decl",
      "category": "variable",
      "syntax": "int name = 表达式\nstr name = \"文本\"\nPerson p = new Person(…)\nlist xs = [1, 2]\nlist name",
      "body": false,
      "notes": "0.2 起初始化值走完整表达式求值（0.1.0 只接受字面量）。类型名只作标注，不做强制校验"
    },
    {
      "ast": "var_assign",
      "category": "variable",
      "syntax": "name = 表达式\np.field = 值\nxs[0] = 值\nd[\"键\"] = 值",
      "body": false,
      "notes": "支持变量、成员、下标三种赋值目标"
    },
    {
      "ast": "var_compound",
      "category": "variable",
      "syntax": "name += / -= / *= /= /= %= **= 表达式",
      "body": false
    },
    {
      "ast": "var_inc",
      "category": "variable",
      "syntax": "name++",
      "body": false
    },
    {
      "ast": "var_dec",
      "category": "variable",
      "syntax": "name--",
      "body": false
    },
    {
      "ast": "func_def",
      "category": "function",
      "syntax": "fn name(a, b = 默认值)\nfn bool name()\nfunction name() / f name()（旧写法，仍兼容）",
      "body": true,
      "notes": "0.2 起支持多参数、默认值、递归与返回值；函数在顶层先注册，允许先用后定义"
    },
    {
      "ast": "func_call",
      "category": "function",
      "syntax": "name()\nname(a, b)\nx = name(a) + 1\nprint(name(a))",
      "body": false,
      "notes": "0.2 起带参调用可用，且可出现在任意表达式位置"
    },
    {
      "ast": "class_def",
      "category": "class",
      "syntax": "class 名称\nclass 名称 extends 父类",
      "body": true,
      "notes": "类体内写字段与方法；init 为构造方法，super(…) 调父类 init"
    },
    {
      "ast": "field_decl",
      "category": "class",
      "syntax": "str name\nint hp = 100\nhp = 100",
      "body": false
    },
    {
      "ast": "method_def",
      "category": "class",
      "syntax": "fn 方法名(参数)",
      "body": true
    },
    {
      "ast": "new",
      "category": "class",
      "syntax": "new 类名(参数)",
      "body": false
    },
    {
      "ast": "self",
      "category": "class",
      "syntax": "self / self.字段 / 裸名字段",
      "body": false,
      "notes": "方法内字段可裸名读写，也可以用 self 显式指定"
    },
    {
      "ast": "member_access",
      "category": "class",
      "syntax": "obj.字段\nobj.方法(…)",
      "body": false
    },
    {
      "ast": "member_assign",
      "category": "class",
      "syntax": "obj.字段 = 值\nobj.字段 += 值",
      "body": false
    },
    {
      "ast": "print",
      "category": "io",
      "syntax": "print(\"文本\")\nprint(值, 值, …)",
      "body": false
    },
    {
      "ast": "ask",
      "category": "io",
      "syntax": "ask \"问题\"",
      "body": false
    },
    {
      "ast": "ans",
      "category": "io",
      "syntax": "ans",
      "body": false,
      "notes": "把上一次 ask 的回答写入 __last_ans"
    },
    {
      "ast": "time_read",
      "category": "runtime",
      "syntax": "time read",
      "body": false,
      "notes": "结果写入 __last_time"
    },
    {
      "ast": "time_res",
      "category": "runtime",
      "syntax": "time reset",
      "body": false
    },
    {
      "ast": "import_file",
      "category": "module",
      "syntax": "import \"file.ext\"",
      "body": false
    },
    {
      "ast": "import_folder",
      "category": "module",
      "syntax": "import \"folder\"",
      "body": false
    },
    {
      "ast": "list_new",
      "category": "list",
      "syntax": "list name\nlist name = [1, 2]",
      "body": false
    },
    {
      "ast": "list_add",
      "category": "list",
      "syntax": "add 值 to name",
      "body": false,
      "notes": "值可以是表达式"
    },
    {
      "ast": "list_del",
      "category": "list",
      "syntax": "del name 下标",
      "body": false
    },
    {
      "ast": "list_insert",
      "category": "list",
      "syntax": "insert 值 to name at 下标",
      "body": false
    },
    {
      "ast": "list_rep",
      "category": "list",
      "syntax": "replace name 下标 with 值",
      "body": false
    },
    {
      "ast": "list_read",
      "category": "list",
      "syntax": "read name 下标",
      "body": false,
      "notes": "结果写入 __last_read"
    },
    {
      "ast": "list_len",
      "category": "list",
      "syntax": "len name",
      "body": false,
      "notes": "结果写入 __last_len"
    },
    {
      "ast": "list_in",
      "category": "list",
      "syntax": "listin(值, name)",
      "body": false,
