// 08 对话游戏：《末班地铁》
// 一个纯文字的对话式小故事，靠 ask 推进，选择不同结局不同。
// 练的是：状态变量 + 条件分支 + 字符串处理。

int courage = 0
int clues = 0
str name = "你"

fn line(who, text)
    print(join(who, "：", text))

fn pause_hint()
    print("")

print("========================================")
print("  末班地铁")
print("========================================")
line("旁白", "23:47，站台上只剩下你一个人。")
line("旁白", "广播说末班车还有三分钟到，可隧道深处传来一阵奇怪的声音。")

while (true)
    print("")
    print("你要怎么做？")
    print("  1. 当作没听见，继续等车")
    print("  2. 顺着声音走进隧道看看")
    print("  3. 先看看墙上那张旧告示")
    ask "输入 1 / 2 / 3："
    str pick = trim(ans)
    if (pick == "")
        print("（沉默中，时间一分一秒过去）")

    if (pick == "1")
        line("旁白", "你盯着手机，假装什么都没发生。")
        if (clues > 0)
            line("你", "（可我已经知道那声音是什么了……）")
            courage += 1
        if (courage >= 2)
            line("旁白", "列车进站，车门打开，车厢里空无一人。")
            line("旁白", "你还是走了进去。故事从这里才真正开始。")
            return
        line("旁白", "列车进站。你上车了，一路无事。")
        line("旁白", "—— 结局：安全的乘客。")
        return

    if (pick == "2")
        line("旁白", "你踩着碎石走进隧道，手机电筒只照亮三米。")
        if (clues == 0)
            line("旁白", "声音突然停了。你在黑暗里站了很久，最后退了出来。")
            courage += 1
            line("旁白", "（勇气 +1）")
        else
            line("你", "（告示上说，别追着声音走，要等它自己停。）")
            line("旁白", "你停下脚步。声音果然在三秒后消失了。")
            line("旁白", "墙上露出一扇小门。")
            line("旁白", "—— 结局：隧道尽头的人。")
            return

    if (pick == "3")
        line("旁白", "告示已经泛黄，上面是手写的几行字：")
        line("告示", "「本站末班车从不载客。听见有人叫你名字，不要回头。」")
        clues += 1
        line("旁白", "（线索 +1）")
        if (clues >= 2)
            line("旁白", "你把告示撕下来折好，放进口袋。")
            line("旁白", "—— 结局：知情者。")
            return

    if (pick != "1" && pick != "2" && pick != "3")
        line("旁白", "你犹豫了一下，什么也没做。")
