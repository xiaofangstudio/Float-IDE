fn clean(str t)
    return t.trim()

fn has_item(str id)
    if G["inv"].has(id)
        return G["inv"][id] > 0
    return false

fn give_item(str id, int n)
    if G["inv"].has(id)
        G["inv"][id] += n
    else
        G["inv"][id] = n

fn add_aff(str nid, int d)
    int v = G["aff"][nid] + d
    if v > 100
        v = 100
    if v < 0
        v = 0
    G["aff"][nid] = v
    if AND2(v >= 70, !G["flags"].has("aff70_" + nid))
        G["flags"]["aff70_" + nid] = 1
        say("💛 你和" + NPCS[nid]["name"] + "的关系更近了一步。")

fn push_recent(str app)
    list nr = [app]
    for a in G["recent"]
        if AND2(a != app, nr.len() < 3)
            nr.push(a)
    G["recent"] = nr

fn inv_cap()
    if G["equip"]["背包"] == "双肩包"
        return 13
    return 10

/* 关键物品不占格：手机、钥匙、交通卡
fn bool is_key_item(str id)
    if id == "手机"
        return true
    if id == "家门钥匙"
        return true
    if id == "交通卡"
        return true
    return false

fn inv_count()
    int n = 0
    for id in G["inv"].keys()
        if G["inv"][id] > 0
            if !is_key_item(id)
                n += 1
    /* 廿七是一只猫，占 5 格；抱着的野猫也占 5 格
    if G["cat"]["with_you"]
        n += 5
    if wild_carried() != ""
        n += 5
    return n

fn describe(bool full)
    dict locd = LOCS[G["loc"]]
    if OR2(full, !G["visited"].has(G["loc"]))
        say("📍 " + G["loc"] + "（" + locd["area"] + "）")
        say("   " + locd["desc"])
        G["visited"][G["loc"]] = 1
    else
        say("📍 " + G["loc"] + "（" + locd["area"] + "）——输 看看 重读描述")
    list ns = npcs_here()
    if ns.len() > 0
        str names = ""
        for nid in ns
            names = names + NPCS[nid]["name"] + "  "
        say("👥 在场：" + names)
    if G["cat"]["with_you"]
        say("🐱 廿七被你抱在怀里，占了 5 个物品栏格，尾巴搭在你胳膊上。")
    elif G["cat"]["spot"] == G["loc"]
        if G["loc"] == "卧室"
            say("🐱 廿七正霸着你的枕头，尾巴一甩一甩。")
        elif G["loc"] == "楼梯下暗门"
            say("🐱 廿七从方佳的秘密基地里探出头——它居然知道暗门怎么开。")
        elif G["loc"] == "后院"
            say("🐱 廿七趴在榕树影子里，看蚂蚁搬家。")
        elif G["loc"] == "方方后院"
            say("🐱 廿七蹲在方方家泳池边，爪子试探性地拍水面。")
        else
            say("🐱 廿七不知道什么时候溜到了这里，正蹲在那儿看你。")
    str wcar = wild_carried()
    if wcar != ""
        say("🐈 " + wcar + "也被你抱着，占 5 个物品栏格。它和廿七互相盯着。")
    list wh = wild_at_here()
    if wh.len() > 0
        str wnames = ""
        for wi in wh
            wnames = wnames + wi + "  "
        say("🐈 附近有野猫：" + wnames + "（输 野猫 靠近）")

/* 布尔辅助：CW 的 and/or 只取左值，用函数实现正确语义
fn bool AND2(bool x, bool y)
    if x
        if y
            return true
    return false

fn bool OR2(bool x, bool y)
    if x
        return true
    if y
        return true
    return false

fn bfs_route(str dst, int allow_rail)
    if G["loc"] == dst
        return [G["loc"]]
    list queue = [G["loc"]]
    dict prev = {}
    dict vis = {}
    vis[G["loc"]] = 1
    int head = 0
    while head < queue.len()
        str cur = queue[head]
        head += 1
        if EDGES.has(cur)
            list es = EDGES[cur]
            for edge in es
                if OR2(allow_rail == 1, edge[2] == 0)
                    str nb = edge[0]
                    if !vis.has(nb)
                        vis[nb] = 1
                        prev[nb] = cur
                        queue.push(nb)
    if !vis.has(dst)
        return []
    list back = [dst]
    str tail = dst
    while tail != G["loc"]
        tail = prev[tail]
        back.push(tail)
    list route = []
    int i = back.len() - 1
    while i >= 0
        route.push(back[i])
        i -= 1
    return route

fn edge_mins(str a, str b)
    list es = EDGES[a]
    for e in es
        if e[0] == b
            return e[1]
    return 0

fn travel_walk(str dst)
    if dst == G["loc"]
        say("你已经在这里了。")
        return
    list route = bfs_route(dst, 0)
    if route.len() == 0
        say("🚶 走不到——这段路太远，或者中间隔着海。得坐空铁。（先去最近的空铁站）")
        return
    int total = 0
    int i = 1
    while i < route.len()
        total += edge_mins(route[i - 1], route[i])
        G["loc"] = route[i]
        i += 1
    if G["cat"]["with_you"]
        say("🚶 你提着航空箱走了 " + str(total) + " 分钟，来到【" + G["loc"] + "】。廿七在里面咕噜咕噜。")
    else
        say("🚶 你走了 " + str(total) + " 分钟，来到【" + G["loc"] + "】。")
    if total >= 20
        G["phone"]["batt"] -= 1
        if G["phone"]["batt"] < 1
            G["phone"]["batt"] = 1
    describe(false)

fn rail_to(str dst, int mins, str line)
    if G["money"] < 2
        say("💳 余额不足——坐空铁要 2 方币。")
        return
    G["money"] -= 2
    say("🚈 你刷了交通卡（-2 方币）。【" + line + "】进站，车门无声滑开。")
    if G["cat"]["with_you"]
        say("  检票员看了眼航空箱：『宠物请放脚边哦。』廿七在箱子里打了个哈欠。")
    G["loc"] = dst
    advance(mins)
    if mins >= 100
        say("  这是一段长途旅行，窗外从海面变成云海，或者相反。")
    say("🚉 到达【" + G["loc"] + "】。")
    describe(false)

fn rail_menu()
    list opts = []
    list es = EDGES[G["loc"]]
    for e in es
        if e[2] == 1
            opts.push(e)
    if opts.len() == 0
        say("这里不是空铁站。")
        return
    print("")
    say("🚈 空铁站 · 线路图（单程 2 方币）")
    for i in range(opts.len())
        str ln = "空铁"
        if RAILLINE.has(opts[i][0])
            ln = RAILLINE[opts[i][0]]
        say("  " + str(i + 1) + ". 【" + ln + "】→ " + opts[i][0] + "（" + str(opts[i][1]) + " 分钟）")
    say("  0. 不坐了")
    ask "＞ 去哪一站？"
    str c = clean(ans)
    if c == "0"
        return
    for i in range(opts.len())
        if c == str(i + 1)
            str ln2 = "空铁"
            if RAILLINE.has(opts[i][0])
                ln2 = RAILLINE[opts[i][0]]
            rail_to(opts[i][0], opts[i][1], ln2)
            return
    say("（没有这班车。）")

/* ------------------------------------------------------------
/* 八、物品栏 / 装备栏 / 商店
/* ------------------------------------------------------------
fn inv_menu()
    print("")
    say("🎒 物品栏（" + str(inv_count()) + "/" + str(inv_cap()) + " 格，同类叠放）")
    bool any = false
    for id in G["inv"].keys()
        if G["inv"][id] > 0
            any = true
            str tag = ITEMS[id]["kind"]
            if is_key_item(id)
                tag = "关键·不占格"
            say("  · " + ITEMS[id]["name"] + " ×" + str(G["inv"][id]) + "【" + tag + "】" + ITEMS[id]["desc"])
    if !any
        say("  （空空如也）")
    if G["cat"]["with_you"]
        say("  🐱 廿七（抱在怀里）—— 占 5 格")
    str wc = wild_carried()
    if wc != ""
        say("  🐈 " + wc + "（抱在怀里）—— 占 5 格")
    say("  （试试：使用面包 / 装备运动鞋 / 猫咪）")

fn use_item(str name)
    str iid = ""
    for id in G["inv"].keys()
        if AND2(ITEMS[id]["name"] == name, G["inv"][id] > 0)
            iid = id
    if iid == ""
        say("你没有这个东西。")
        return
    str kind = ITEMS[iid]["kind"]
    if kind == "食物"
        G["inv"][iid] -= 1
        say("😋 你吃掉了" + ITEMS[iid]["name"] + "。满足。")
        if iid == "臭豆腐"
            say("  （闻着臭吃着香，附近的人纷纷侧目。）")
    elif kind == "书"
        if !G["flags"].has("read_" + iid)
            G["flags"]["read_" + iid] = 1
            G["rep"]["学校"] += 1
            say("📖 你认真读完了《" + ITEMS[iid]["name"] + "》，感觉脑子里多了点什么。（学校声望+1）")
        else
            say("这本你读过了，再翻就是复习。")
    elif kind == "装备"
        equip_item(iid)
    elif kind == "猫用品"
        say("这是给廿七的——去猫窝角，或者带着它的时候用。")
    elif kind == "零件"
        say("零件要装进机箱才有意义。找方方，或者自己去数码港。")
    elif kind == "关键"
        say("这是随身的关键物品，不能直接使用。")
    else
        say("你把" + ITEMS[iid]["name"] + "拿出来看了看，又放了回去。")

fn equip_item(str iid)
    if !EQSLOT.has(iid)
        say(ITEMS[iid]["name"] + "不是可装备的物品。")
        return
    str slot = EQSLOT[iid]
    str old = G["equip"][slot]
    if old == ITEMS[iid]["name"]
        say("这件你已经装备着了。")
        return
    if AND2(old != "无", ITEMS.has(old))
        G["inv"][old] += 1
    G["equip"][slot] = ITEMS[iid]["name"]
    G["inv"][iid] -= 1
    say("👔 你把【" + ITEMS[iid]["name"] + "】装备到了" + slot + "栏。")
    if iid == "双肩包"
        say("  物品栏容量提升到 23 格。")

fn equip_menu()
    print("")
    say("👔 装备栏")
    list slots = ["上衣", "背包", "手部", "配饰", "鞋子"]
    for slot in slots
        str v = G["equip"][slot]
        if v == "无"
            say("  " + slot + "：（空）")
        else
            say("  " + slot + "：" + v)
    list eq = []
    for id in G["inv"].keys()
        if AND2(G["inv"][id] > 0, ITEMS[id]["kind"] == "装备")
            eq.push(id)
    if eq.len() == 0
        say("（背包里没有可装备的物品。商场2F服饰区有卖。）")
        return
    say("  可装备：")
    for i in range(eq.len())
        say("  " + str(i + 1) + ". " + ITEMS[eq[i]]["name"] + " → " + EQSLOT[eq[i]] + "栏")
    say("  0. 什么都不动")
    ask "＞ 装备哪个？"
    str c = clean(ans)
    if c == "0"
        return
    for i in range(eq.len())
        if c == str(i + 1)
            equip_item(eq[i])
            return
    say("（没有这个选项。）")

fn shop_menu()
    if !SHOPSTOCK.has(G["loc"])
        say("这里没有商店。")
        return
    list stock = SHOPSTOCK[G["loc"]]
    bool on = true
    while on
        print("")
        say("🛒 欢迎光临！钱包：" + str(G["money"]) + " 方币 · 物品栏 " + str(inv_count()) + "/" + str(inv_cap()))
        for i in range(stock.len())
            say("  " + str(i + 1) + ". " + ITEMS[stock[i]]["name"] + " — " + str(ITEMS[stock[i]]["price"]) + " 方币")
        say("  0. 告辞")
        ask "＞ 买什么？"
        str c = clean(ans)
        if c == "0"
            on = false
        else
            bool ok = false
            for i in range(stock.len())
                if c == str(i + 1)
                    ok = true
                    int price = ITEMS[stock[i]]["price"]
                    if G["money"] < price
                        say("💰 钱不够。店员微笑着看着你。")
                    elif inv_count() >= inv_cap()
                        if !G["inv"].has(stock[i])
                            say("🎒 物品栏满了（装备双肩包可扩容到 23）。")
                    else
                        G["money"] -= price
                        give_item(stock[i], 1)
                        say("🛍 你买下了【" + ITEMS[stock[i]]["name"] + "】（- " + str(price) + " 方币）。")
            if !ok
                say("（店员没听懂。）")
    say("（你走出了店门。）")

/* ------------------------------------------------------------
/* 九、手机（方聊 / 相册 / 音乐 / 天气 / fang online / 设置 / 最近应用 / 充电）
/* ------------------------------------------------------------
fn fangliao()
    push_recent("方聊")
    G["phone"]["unread"] = 0
    if !G["flags"].has("chat_intro")
        G["flags"]["chat_intro"] = 1
        print("")
        say("💬 方聊 · 未读消息")
        say("  方方：『起床没？今天去数码港蹲二手显卡，去不去？』")
        say("  方琪：『哥！妈妈说晚饭有你爱吃的排骨！』")
    bool on = true
    while on
        print("")
        say("💬 方聊 · 联系人（电量 " + str(G["phone"]["batt"]) + "%）")
        list ids = []
        for nid in NPCS.keys()
            ids.push(nid)
        for i in range(ids.len())
            str heart = ""
            if G["aff"][ids[i]] >= 70
                heart = " 💛"
            say("  " + str(i + 1) + ". " + NPCS[ids[i]]["name"] + "（好感 " + str(G["aff"][ids[i]]) + "）" + heart)
        say("  0. 退出方聊")
        ask "＞ 找谁聊？"
        str c = clean(ans)
        if c == "0"
            on = false
        else
            bool ok = false
            for i in range(ids.len())
                if OR2(c == str(i + 1), c == ids[i])
                    ok = true
                    chat_with(ids[i])
            if !ok
                say("（查无此人。）")

fn chat_with(str nid)
    push_recent("方聊")
    dict n = NPCS[nid]
    print("")
    say("── 和【" + n["name"] + "】的方聊对话 ──（输入 退出 结束）")
    bool on = true
    while on
        ask "＞ 你说："
        str msg = clean(ans)
        if OR2(msg == "退出", msg == "退")
            on = false
        elif msg == ""
            say("（你不知道说啥。随便聊点别的吧。）")
        else
            G["phone"]["batt"] -= 1
            if G["phone"]["batt"] < 1
                G["phone"]["batt"] = 1
            say(n["name"] + "：" + eliza_reply(nid, msg))
            add_aff(nid, 1)
    say("（你退出了对话。）")

