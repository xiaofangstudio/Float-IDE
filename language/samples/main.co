fn set_app()
    push_recent("设置")
    print("")
    say("⚙️ 设置 · 方芯 Z50（方岛版）")
    if G["theme"] == "深色"
        G["theme"] = "浅色"
    else
        G["theme"] = "深色"
    say("  主题已切换为【" + G["theme"] + "】。")
    say("  关于本机：方芯 Z50 · 512G · 电量 " + str(G["phone"]["batt"]) + "%")
    say("  恢复出厂设置：你盯着按钮看了三秒，忍住了。")

fn charge_phone()
    if OR2(G["loc"] == "卧室", OR2(G["loc"] == "23085房", OR2(G["loc"] == "云巅之光酒店", OR2(G["loc"] == "楼梯下暗门", G["loc"] == "房车·车厢"))))
        say("🔌 手机插上充电器，电量 " + str(G["phone"]["batt"]) + "% → 100%")
        G["phone"]["batt"] = 100
        advance(30)
    else
        say("这里没有你的充电器。（卧室 / 秘密基地 / 酒店 / 房车可以充）")

fn phone_menu()
    if G["phone"]["batt"] <= 5
        say("📱 屏幕闪了两下，黑了——手机没电了。（回家充电）")
        return
    bool on = true
    while on
        G["phone"]["batt"] -= 1
        if G["phone"]["batt"] < 1
            G["phone"]["batt"] = 1
            say("📱 手机电量见底，自动锁屏了。（充电后继续）")
            return
        print("")
        say("📱 方芯 Z50 · " + G["theme"] + " · 电量 " + str(G["phone"]["batt"]) + "% · ✉" + str(G["phone"]["unread"]))
        say("  1. 💬 方聊")
        say("  2. 🖼 相册")
        say("  3. 🎵 音乐")
        say("  4. 🌤 天气")
        say("  5. 🌐 fang online")
        say("  6. ⚙️ 设置")
        if G["recent"].len() > 0
            str rec = ""
            for a in G["recent"]
                rec = rec + a + " / "
            say("  ⏱ 最近应用：" + rec)
            for i in range(G["recent"].len())
                say("      " + str(7 + i) + ". ⏱ 重新打开【" + G["recent"][i] + "】")
        say("  99. 🔌 充电")
        say("  0. 退出手机")
        ask "＞ 手机＞"
        str c = clean(ans)
        if c == "0"
            on = false
        elif c == "1"
            fangliao()
        elif c == "2"
            album_app()
        elif c == "3"
            music_app()
        elif c == "4"
            weather_app()
        elif c == "5"
            web_app()
        elif c == "6"
            set_app()
        elif c == "99"
            charge_phone()
        else
            bool hit = false
            for i in range(G["recent"].len())
                if c == str(7 + i)
                    hit = true
                    str app = G["recent"][i]
                    if app == "方聊"
                        fangliao()
                    elif app == "相册"
                        album_app()
                    elif app == "音乐"
                        music_app()
                    elif app == "天气"
                        weather_app()
                    elif app == "fang online"
                        web_app()
                    elif app == "设置"
                        set_app()
            if !hit
                say("（没有这个应用。）")

/* ------------------------------------------------------------
/* 十、电脑（记事本 / 方舟问答 / 磁盘清理=搞崩风险 / 编程练习）
/* ------------------------------------------------------------
fn pc_menu()
    print("")
    if G["pc"]["broken"]
        print("  ┌──────────────────────────────────┐")
        print("  │  :(  你的电脑遇到问题，需要重启    │")
        print("  │  停止代码：FANG_0x27_BLUE         │")
        print("  │  （只有数码港·装机店能救它）        │")
        print("  └──────────────────────────────────┘")
        return
    bool on = true
    while on
        say("🖥 电脑 · 刘小方的PC（日记 " + str(G["pc"]["diary"]) + " 篇 · 玩过 " + str(G["pc"]["games"]) + " 次）")
        say("  1. 📝 记事本")
        say("  2. 🤖 方舟问答（AI 三连问）")
        say("  3. 🧹 磁盘清理（风险自负）")
        say("  4. 📚 编程练习")
        say("  0. 关机")
        ask "＞ 电脑＞"
        str c = clean(ans)
        if c == "0"
            on = false
        elif c == "1"
            ask "＞ 写点什么："
            str t = clean(ans)
            if t != ""
                G["pc"]["diary"] += 1
                say("📝 已保存《日记" + str(G["pc"]["diary"]) + ".txt》。你心情不错。")
        elif c == "2"
            ark_quiz()
        elif c == "3"
            disk_clean()
        elif c == "4"
            if OR2(G["flags"].has("read_编程书"), G["inv"].has("编程书"))
                if !G["flags"].has("code1")
                    G["flags"]["code1"] = 1
                    G["rep"]["学校"] += 1
                    say("💻 你写了 50 行 CW Script，一次跑通。成就感 +1（学校声望+1）")
                else
                    say("💻 你又写了个小程序：自动计算廿七的饭量。运行结果：永远吃不饱。")
            else
                say("📚 你连《CW Script 入门》都还没读。（先在物品栏里 使用编程书）")

fn ark_quiz()
    say("🤖 方舟：『检测到人类幼崽。回答三问，检验你的常识。』")
    ask "＞ 第1问：方岛之眼有多高？"
    str a1 = clean(ans)
    int score = 0
    if OR2(a1.contains("318"), a1.contains("三百"))
        score += 1
        say("🤖 方舟：『正确。315米观景层，318米塔尖。』")
    else
        say("🤖 方舟：『318米。下次抬头看的时候记一下。』")
    ask "＞ 第2问：能源中心的反应堆叫什么？"
    str a2 = clean(ans)
    if OR2(a2.contains("KOS"), a2.contains("kos"))
        score += 1
        say("🤖 方舟：『正确。KOS-1。就是曾经让地面裂开的那位。』")
    else
        say("🤖 方舟：『KOS-1。你爸爸工作的地方，建议记住。』")
    ask "＞ 第3问：天空王国的能源石叫什么？"
    str a3 = clean(ans)
    if a3.contains("蓝石")
        score += 1
        say("🤖 方舟：『正确。蓝石。请勿在旧墟捡拾后随身携带——好吧，你已经带了。』")
    else
        say("🤖 方舟：『蓝石。你围巾会发光的那个。』")
    G["pc"]["games"] += 1
    if score == 3
        say("🤖 方舟：『满分。允许你自封为方岛百晓生。』")
    else
        say("🤖 方舟：『答对 " + str(score) + " / 3。教育是一个漫长的过程。』")

fn disk_clean()
    say("🧹 磁盘清理扫描中……发现 12.7GB 可清理空间。")
    say("  其中 8GB 是缓存，4.7GB 是『来路不明的 system 文件』。")
    ask "＞ 全部删除吗？（1 是 / 2 算了）"
    str c = clean(ans)
    if c == "1"
        int luck = rnd(10)
        if luck <= 4
            G["pc"]["broken"] = true
            say("🧹 正在删除……屏幕突然一黑。")
            print("  ┌──────────────────────────────────┐")
            print("  │  :(  你的电脑遇到问题，需要重启    │")
            print("  │  停止代码：FANG_0x27_BLUE         │")
            print("  └──────────────────────────────────┘")
            say("💀 你把电脑搞崩了。（去数码港·装机店花 50 方币修）")
        else
            say("🧹 清理完成！电脑快了不少。（幸好删掉的只是缓存）")
    else
        say("🧹 你管住了自己的手。电脑表示很欣慰。")

/* ------------------------------------------------------------
/* 十一、猫系统（廿七：喂食/铲屎/逗猫/带上出门=带猫跑路）
/* ------------------------------------------------------------
/* ------------------------------------------------------------
/* 十一·五、野猫系统（社区随机刷猫 · 好感 · 抱回家 · 猫对决）
/* ------------------------------------------------------------
dict WILD = {}

fn build_wild()
    WILD["黑豆"] = "黑得发亮的小母猫，琥珀色眼睛，尾巴尖有一撮白。"
    WILD["橘皮"] = "一只胖橘，见人就翻肚皮，翻完就跑。"
    WILD["三花"] = "三花猫，总蹲在墙头上，眼神像在审你。"
    WILD["煤球"] = "脏兮兮的小黑猫，左耳缺了个口。"
    WILD["奶盖"] = "方方家的白猫，头顶一撮奶油色，脾气好得不像猫。"

fn boot_wild()
    dict w = {}
    w["黑豆"] = {"loc": "比多饭", "aff": 0, "carry": false}
    w["橘皮"] = {"loc": "社区公园", "aff": 5, "carry": false}
    w["三花"] = {"loc": "休闲驿站", "aff": 0, "carry": false}
    w["煤球"] = {"loc": "便利店", "aff": 10, "carry": false}
    w["奶盖"] = {"loc": "方方客厅", "aff": 40, "carry": false}
    G["wild"] = w

fn wild_roam()
    list spots = ["栖霞街道", "社区公园", "便利店", "休闲驿站", "比多饭"]
    list names = ["黑豆", "橘皮", "三花", "煤球"]
    str nm = names[rnd(names.len()) - 1]
    if G["wild"][nm]["carry"] == false
        G["wild"][nm]["loc"] = spots[rnd(spots.len()) - 1]
    list fspots = ["方方客厅", "方方后院", "方方房间", "工具房"]
    if G["wild"]["奶盖"]["carry"] == false
        G["wild"]["奶盖"]["loc"] = fspots[rnd(fspots.len()) - 1]

fn wild_at_here()
    list out = []
    for nm in G["wild"].keys()
        if G["wild"][nm]["loc"] == G["loc"]
            out.push(nm)
    return out

fn wild_carried()
    for nm in G["wild"].keys()
        if G["wild"][nm]["carry"]
            return nm
    return ""

fn wild_search()
    list names = ["黑豆", "橘皮", "三花", "煤球"]
    if rnd(10) <= 7
        str nm = names[rnd(names.len()) - 1]
        if G["wild"][nm]["carry"]
            say("🐈 你听见一声猫叫，可那只猫正被你抱在怀里。")
        else
            G["wild"][nm]["loc"] = G["loc"]
            say("🐈 你在角落里发现一只猫——" + WILD[nm])
            wild_menu()
    else
        say("🐈 你蹲在墙根等了半天，只等到一只塑料袋被风吹过。")

fn wild_menu()
    print("")
    str carried = wild_carried()
    if carried != ""
        say("🐈 你怀里抱着【" + carried + "】。它四条腿蹬得笔直，尾巴扫着你的胳膊。")
        say("  好感 " + str(G["wild"][carried]["aff"]) + "/100（占 5 个物品栏格）")
        say("  1. 🤲 摸摸它")
        say("  2. 🍚 喂点吃的")
        say("  3. 🏠 放下它")
        say("  4. ⚔️ 放它下来，和廿七打一场（廿七在场时）")
        say("  0. 抱紧，不撒手")
        ask "＞ "
        str c = clean(ans)
        if c == "0"
            return
        if c == "1"
            if G["wild"][carried]["aff"] < 20
                say("😾 它在你怀里扭了一下，后爪在你手背上踩出两个白点。")
            else
                G["wild"][carried]["aff"] += 2
                say("🤲 它慢慢松了劲，把下巴搁在你手腕上。呼噜声很小，但确实有。")
        elif c == "2"
            wild_feed(carried)
        elif c == "3"
            G["wild"][carried]["carry"] = false
            G["wild"][carried]["loc"] = G["loc"]
            say("🏠 你把它放在" + G["loc"] + "。它抖了抖毛，先假装不在意，然后蹭了一下你的裤脚。")
        elif c == "4"
            bool c1 = G["cat"]["with_you"]
            bool c2 = G["cat"]["spot"] == G["loc"]
            if OR2(c1, c2)
                G["wild"][carried]["carry"] = false
                G["wild"][carried]["loc"] = G["loc"]
                cat_battle(carried)
            else
                say("廿七不在这儿。先把两只猫凑到一个屋檐下再说。")
        return
    list here = wild_at_here()
    if here.len() == 0
        say("🐈 附近没有野猫。社区街道、公园、便利店、休闲驿站、比多饭的后巷，都有人见过。")
        say("  （试试在这些地方输 找野猫。）")
        return
    say("🐈 附近有 " + str(here.len()) + " 只猫：")
    for i in range(here.len())
        say("  " + str(i + 1) + ". " + here[i] + " —— " + WILD[here[i]])
        say("     好感 " + str(G["wild"][here[i]]["aff"]) + "/100")
    say("  0. 退后一步")
    ask "＞ 靠近哪只？"
    str pick = clean(ans)
    if pick == "0"
        return
    str nm = ""
    for i2 in range(here.len())
        if pick == str(i2 + 1)
            nm = here[i2]
    if nm == ""
        say("（你看了看，没敢动。）")
        return
    wild_one(nm)

fn wild_feed(str nm)
    if has_item("猫粮")
        G["inv"]["猫粮"] -= 1
        G["wild"][nm]["aff"] += 12
    elif has_item("面包")
        G["inv"]["面包"] -= 1
        G["wild"][nm]["aff"] += 6
    elif has_item("关东煮")
        G["inv"]["关东煮"] -= 1
        G["wild"][nm]["aff"] += 9
    else
        say("🍚 你口袋比脸还干净。它闻了闻，失望地走开了。")
        return
    if G["wild"][nm]["aff"] > 100
        G["wild"][nm]["aff"] = 100
    say("🍚 " + nm + "低头猛吃，尾巴尖一直在抖。吃完还舔了舔你的手指。（好感现在 " + str(G["wild"][nm]["aff"]) + "/100）")

fn wild_one(str nm)
    say("🐈 " + nm + "：" + WILD[nm])
    say("  好感 " + str(G["wild"][nm]["aff"]) + "/100 · 抱它需要 60")
    say("  1. 🤲 蹲下，慢慢伸手")
    say("  2. 🍚 喂点吃的")
    say("  3. 🫳 试着抱起它")
    say("  0. 退后一步")
    ask "＞ "
    str c = clean(ans)
    if c == "0"
        return
    if c == "1"
        if G["wild"][nm]["aff"] < 40
            if rnd(10) <= 4
                G["wild"][nm]["aff"] -= 3
                if G["wild"][nm]["aff"] < 0
                    G["wild"][nm]["aff"] = 0
                advance(5)
                say("😾 它突然抬爪——你手背上多了三道血印。")
                say("  （野猫不是廿七。先喂它，再谈感情。）")
            else
                G["wild"][nm]["aff"] += 3
                say("🤲 它盯着你的手看了很久，终于允许你碰了碰它的耳根。")
        else
            G["wild"][nm]["aff"] += 5
            say("🤲 它主动把脑袋往你掌心里顶，喉咙里滚出一串小摩托。")
    elif c == "2"
        wild_feed(nm)
    elif c == "3"
        if G["wild"][nm]["aff"] < 60
            say("😼 它身子一矮，从你手底下滑走，蹲在三步外看你。")
            say("  （好感 60 以上才肯让你抱。）")
        elif inv_count() + 5 > inv_cap()
            say("🎒 物品栏只剩 " + str(inv_cap() - inv_count()) + " 格，抱一只猫要占 5 格。")
        else
            G["wild"][nm]["carry"] = true
            G["wild"][nm]["loc"] = G["loc"]
            say("🫳 你把它抱起来。它僵了两秒，然后把爪子搭在你肩上——成了。")
            say("  （占 5 个物品栏格。可以抱回家，或者带去和廿七打一场。）")

fn cat_battle(str nm)
    print("")
    say("⚔️ 廿七 VS " + nm + " —— 客厅中央，猫界擂台。")
    say("  方琪搬来小板凳，方佳掏出笔记本：『对照组，三足对四足。』")
    int h1 = 100
    int h2 = 100
    int fear = 0
    bool on = true
    while on
        say("  ── 廿七 " + str(h1) + " HP ｜ " + nm + " " + str(h2) + " HP ──")
        say("  1. 三足飞扑（猛，可能扑空）  2. 连环挠（稳）")
        say("  3. 炸毛威慑（降对手伤害）  4. 舔爪回血")
        ask "＞ 廿七使出："
        str c = clean(ans)
        int dmg = 0
        if c == "1"
            if rnd(10) <= 6
                dmg = rnd(12) + 16
                say("🐾 廿七三足蹬地，像一颗姜黄色炮弹——正中！")
            else
                say("🐾 廿七扑了个空，在茶几上紧急刹车，假装刚才那是战术。")
        elif c == "2"
            dmg = rnd(8) + 8
            say("🐾 左右开弓，两爪子都结结实实。")
        elif c == "3"
            fear = 2
            say("🐾 廿七弓成一只刺猬，全身毛炸开——" + nm + "明显愣了一下。")
        elif c == "4"
            h1 += 12
            if h1 > 100
                h1 = 100
            say("🐾 廿七低头舔爪子，顺便用眼角余光观察对手。")
        else
            say("（廿七没听懂，歪头看你。）")
        if dmg > 0
            h2 -= dmg
            say("  " + nm + " 掉了 " + str(dmg) + " HP。")
        if h2 <= 0
            on = false
        else
            int back = rnd(9) + 7
            if fear > 0
                back -= 4
                fear -= 1
            if back < 3
                back = 3
            h1 -= back
            say("  " + nm + " 反手一爪，廿七掉了 " + str(back) + " HP。")
            if h1 <= 0
                on = false
    if h2 <= 0
        G["wild"][nm]["aff"] += 15
        if G["wild"][nm]["aff"] > 100
            G["wild"][nm]["aff"] = 100
        G["cat"]["mood"] += 10
        if G["cat"]["mood"] > 100
            G["cat"]["mood"] = 100
        say("🏆 廿七三足立地，尾巴高高翘起。它赢了，而且赢得很嚣张。")
        say("  " + nm + "翻了个身表示服气。（好感+15 · 廿七心情+10）")
        if !G["flags"].has("cat_champ")
            G["flags"]["cat_champ"] = 1
            say("  🎖 方佳在笔记本上写下：『三足猫，战斗力异常。建议继续观察。』")
    else
        G["cat"]["mood"] -= 10
        if G["cat"]["mood"] < 0
            G["cat"]["mood"] = 0
        G["cat"]["spot"] = "猫窝角"
        G["wild"][nm]["loc"] = "栖霞街道"
        say("💥 廿七被一记肩撞掀翻，爬起来抖了抖毛，一瘸一拐地回猫窝了。")
        say("  （廿七心情-10。它需要一点时间，也需要一点罐头。）")

fn fang_drawer()
    if G["flags"].has("fang_drawer_" + str(G["day"]))
        say("🗄 方方的抽屉今天已经被你光顾过了。再撬他就要装摄像头了。")
        return
    if !lock_game("方方的抽屉")
        say("  （抽屉没开。隔壁传来方方哼歌的声音，你赶紧收手。）")
        return
    G["flags"]["fang_drawer_" + str(G["day"])] = 1
    int r = rnd(4)
    if r == 1
        give_item("神秘零件", 1)
        say("  🎁 抽屉里躺着一个小盒子，贴着『好东西』——神秘零件。（获得：神秘零件）")
    elif r == 2
        give_item("旧显卡", 1)
        say("  🎁 一块旧显卡，风扇上还有方方写的『还能再战』。（获得：旧显卡）")
    elif r == 3
        give_item("零食大礼包", 1)
        say("  🎁 半抽屉零食。你留了一半，另一半塞进包里。（获得：零食大礼包）")
    else
        G["money"] += 18
        say("  🎁 一个铁盒，里面是 18 方币和一张纸条：『主机基金，勿动。』（+18 方币）")
        say("  （你决定下次还他一个散热器。）")

fn bool lock_game(str tag)
    say("🔐 " + tag + "是老式的三簧锁。你把耳朵贴上去，能听见里面三根弹子轻轻晃。")
    int good = 0
    int need = 0
    for i in range(3)
        need = rnd(3)
        if need == 1
            say("  第" + str(i + 1) + "根：声音轻得像雨点落在铁皮上。")
        elif need == 2
            say("  第" + str(i + 1) + "根：闷闷的，像隔着棉被敲桌子。")
        else
            say("  第" + str(i + 1) + "根：沉，像有人在里面推了一下。")
        ask "＞ 力度？（轻 / 中 / 重）"
        str a = clean(ans)
        bool ok = false
        if AND2(need == 1, a.contains("轻"))
            ok = true
        if AND2(need == 2, a.contains("中"))
            ok = true
        if AND2(need == 3, a.contains("重"))
            ok = true
        if ok
            good += 1
            say("  『咔哒。』弹子归位。")
        else
            say("  『咯——』弹子滑了一下，锁芯发出一声嘲讽。")
    if good >= 2
        say("🔓 最后一下转动，抽屉『嗒』地弹开一条缝。")
        return true
    say("🔒 锁芯卡住了。你抽回发卡，指尖有点抖。")
    return false

fn cat_menu()
    bool on = true
    while on
        print("")
        str where = "在" + G["cat"]["spot"]
        if G["cat"]["spot"] == "卧室"
            where = "占着你的床"
        elif G["cat"]["spot"] == "楼梯下暗门"
            where = "赖在方佳的秘密基地"
        elif G["cat"]["spot"] == "方方后院"
            where = "溜去方方家后院了"
        elif G["cat"]["spot"] == "社区公园"
            where = "在社区公园遛弯"
        if G["cat"]["with_you"]
            where = "被你抱在怀里（占 5 个物品栏格）"
        say("🐱 廿七 · 三脚姜黄猫 · " + where)
        say("   饱腹 " + str(G["cat"]["hunger"]) + "/100（越高越饿） · 心情 " + str(G["cat"]["mood"]) + "/100 · 猫砂卫生 " + str(100 - G["cat"]["litter"]) + "/100")
        say("  1. 🍚 喂猫（需要猫粮）")
        say("  2. 🧹 铲屎")
        say("  3. 🪶 逗猫")
        say("  4. 🤲 摸摸它")
        if G["cat"]["with_you"]
            say("  5. 🤲 放下廿七")
            say("  6. 🏊 把廿七丢进泳池")
            say("  7. 🌳 把廿七扔上榕树")
            say("  8. 🏠 把廿七丢进方方家")
        else
            say("  5. 🤲 抱起廿七（占 5 格，直接带走）")
        say("  0. 好，打扰猫了")
        ask "＞ "
        str k = clean(ans)
        if k == "0"
            on = false
        elif k == "1"
            if has_item("猫粮")
                G["inv"]["猫粮"] -= 1
                G["cat"]["hunger"] -= 60
                if G["cat"]["hunger"] < 0
                    G["cat"]["hunger"] = 0
                G["cat"]["mood"] += 10
                if G["cat"]["mood"] > 100
                    G["cat"]["mood"] = 100
                add_aff("廿七", 2)
                say("🍚 廿七把头埋进猫粮盆，发出小马达一样的声音。（饱腹-60 心情+10）")
            else
                say("没有猫粮了。超市和便利店有卖（15方币四连包）。")
        elif k == "2"
            G["cat"]["litter"] = 10
            G["cat"]["mood"] += 5
            if G["cat"]["mood"] > 100
                G["cat"]["mood"] = 100
            say("🧹 你铲了屎。廿七蹲在旁边全程监督，呼吸暂停。")
        elif k == "3"
            if has_item("逗猫棒")
                G["cat"]["mood"] += 15
                if G["cat"]["mood"] > 100
                    G["cat"]["mood"] = 100
                add_aff("廿七", 1)
                say("🪶 羽毛棒划过空中，廿七三足腾空而起——稳！")
            else
                G["cat"]["mood"] += 8
                if G["cat"]["mood"] > 100
                    G["cat"]["mood"] = 100
                say("🪶 你用手指逗它，它配合地扑了两下。（有逗猫棒会更开心）")
        elif k == "4"
            if G["cat"]["mood"] < 30
                say("😼 廿七赏了你一爪子。它现在心情不好。（先喂饭）")
            else
                G["cat"]["mood"] += 5
                if G["cat"]["mood"] > 100
                    G["cat"]["mood"] = 100
                add_aff("廿七", 1)
                say("🤲 呼噜声震得像小拖拉机。")
        elif k == "5"
            if G["cat"]["with_you"]
                G["cat"]["with_you"] = false
                G["cat"]["home"] = true
                G["cat"]["spot"] = G["loc"]
                say("🏠 你松开手。廿七踱了两步，找了个舒服的地方趴下——就这儿了。")
            elif inv_count() + 5 > inv_cap()
                say("🎒 物品栏只剩 " + str(inv_cap() - inv_count()) + " 格，抱廿七要占 5 格。")
                say("  （先清点一下物品，或者去商场2F买个双肩包。）")
            else
                G["cat"]["with_you"] = true
                G["cat"]["home"] = false
                say("🤲 你把廿七抱起来。它熟门熟路地找了个最舒服的姿势，尾巴搭在你胳膊上。")
                say("  （占 5 个物品栏格。现在去哪都可以带它：空铁、跨岛、甚至天空王国。）")
        elif k == "6"
            do_action("丢猫")
            on = false
        elif k == "7"
            do_action("扔猫上树")
            on = false
        elif k == "8"
            do_action("丢猫方方")
            on = false
    say("（廿七继续干自己的事。）")

/* ------------------------------------------------------------
/* 十二、面对面 NPC 交互（闲聊 / 送礼 / 正事）
/* ------------------------------------------------------------
fn npc_topic(str nid)
    say("📋 " + TOPICT[nid])
    if AND2(nid == "苏明", AND2(G["aff"]["苏明"] >= 60, !G["flags"].has("heart1")))
        G["flags"]["heart1"] = 1
        say("🩺 你们聊起雪山。说到『围巾发光』那段时，苏明点点头：")
        say("  『你看，你早就带着光走出来了。』")
        say("  （有什么东西轻轻放下了。）")

fn gift_menu(str nid)
    list opts = []
    for id in G["inv"].keys()
        if AND2(G["inv"][id] > 0, ITEMS[id]["kind"] != "关键")
            opts.push(id)
    if opts.len() == 0
        say("🎁 你翻遍口袋，只有空气。")
        return
    say("🎁 送点什么？")
    for i in range(opts.len())
        say("  " + str(i + 1) + ". " + ITEMS[opts[i]]["name"] + " ×" + str(G["inv"][opts[i]]))
    say("  0. 还是算了")
    ask "＞ "
    str c = clean(ans)
    if c == "0"
        return
    for i in range(opts.len())
        if c == str(i + 1)
            str id = opts[i]
            G["inv"][id] -= 1
            if id == NPCS[nid]["gift"]
                add_aff(nid, 10)
                say("🎁 对方眼睛一亮：『这也太懂我了吧！！』（好感+10）")
            else
                add_aff(nid, 1)
                say("🎁 对方收下了" + ITEMS[id]["name"] + "，笑得很礼貌。（好感+1）")
            return
    say("（算了。）")

fn npc_menu(str nid)
    dict n = NPCS[nid]
    print("")
    say("【" + n["name"] + "】" + n["desc"])
    bool on = true
    while on
        say("  1. 💬 闲聊   2. 🎁 送礼物   3. 📋 聊正事   0. 告辞")
        ask "＞ "
        str c = clean(ans)
        if c == "0"
            on = false
        elif c == "1"
            ask "＞ 你说："
            str msg = clean(ans)
            if AND2(msg != "", msg != "0")
                say(n["name"] + "：" + eliza_reply(nid, msg))
                add_aff(nid, 1)
        elif c == "2"
            gift_menu(nid)
        elif c == "3"
            npc_topic(nid)
    say("（" + n["name"] + "和你道别。）")

/* ------------------------------------------------------------
/* 十三、场景动作（每个地点的"自由度"）
/* ------------------------------------------------------------
fn photo(str caption)
    G["album"].push("【第" + str(G["day"]) + "天】" + G["loc"] + " · " + caption)
    say("📷 咔嚓！照片已存入相册。")

fn do_sleep()
    if OR2(G["loc"] == "卧室", OR2(G["loc"] == "楼梯下暗门", OR2(G["loc"] == "23085房", OR2(G["loc"] == "云巅之光酒店", G["loc"] == "房车·车厢"))))
        int t = G["tmin"] % 1440
        int delta = 0
        if t < 480
            delta = 480 - t
        else
            delta = 1440 - t + 480
        advance(delta)
        cat_roam()
        G["phone"]["batt"] += 45
        if G["phone"]["batt"] > 100
            G["phone"]["batt"] = 100
        say("🛏 你睡了一觉，醒来时是新的一天。")
        if AND2(G["cat"]["spot"] == "卧室", G["cat"]["hunger"] >= 90)
            G["cat"]["mood"] -= 10
            say("🐱 廿七半夜溜上来蹲在你枕头边，用一种『你睡得挺好的嘛』的眼神看着你。（先喂猫！）")
        elif G["cat"]["spot"] == "卧室"
            say("🐱 廿七不知什么时候钻进了你被窝，呼噜声像小拖拉机。")
        if AND2(G["flags"].has("mail"), G["day"] > G["flags"]["mail"])
            G["flags"].remove("mail")
            G["phone"]["unread"] += 1
            say("📮 妈妈：『你的明信片到了！从 318 米高空寄给自己，可真有你的。』")
        int d = G["day"] % 4
        if d == 0
            say("  梦里你在环岛线上追一只巨大的姜黄猫，列车倒挂着给你让路。")
        elif d == 1
            say("  梦里天空王国的尖塔亮了，围巾的光和它连成一条线。")
        elif d == 2
            say("  梦里是驾考考场，方向盘在你手里变成了猫。方佳在旁边：『别慌。』")
        else
            say("  梦里你把电脑的 system 删了，蓝屏追着你跑了三条街。（吓得你看了眼电脑）")
    else
        say("这里没法睡。（卧室 / 秘密基地 / 酒店 / 房车可以睡）")

fn do_action(str act)
    if act == "用电脑"
        pc_menu()
    elif act == "睡觉"
        do_sleep()
    elif act == "充电"
        charge_phone()
    elif act == "翻储物间"
        if !G["flags"].has("box")
            G["flags"]["box"] = 1
            give_item("航空箱", 1)
            give_item("泳镜", 1)
            say("📦 你在纸箱堆里翻出了：航空箱（带猫出门必备）、一副旧泳镜。")
        else
            say("📦 除了纸箱还是纸箱。天空王国的旧物看不完。")
    elif act == "爬树"
        say("🌳 你三两下蹿上榕树——三脚猫都爬得，你爬不得？")
        if G["loc"] == "后院"
            say("  矮一点的枝上能看见方方家后院；最粗的那根横枝，正好悬在自家泳池上空。")
        if AND2(G["loc"] == "后院", pool_water() >= 100)
            say("  你顺着横枝往前挪了挪。脚下就是泳池的水面，晃晃悠悠的。")
            say("  （输 纵身一跳 试试跳水，输 不跳怂了 下来。）")
            ask "＞ "
            str c1 = clean(ans)
            if c1.contains("跳")
                say("💦 你从榕树横枝纵身一跃——『咚！！』水花溅到了过滤控制盒上。")
                if OR2(has_item("相机"), G["equip"]["手部"] == "相机")
                    photo("榕树横枝跳水瞬间，表情包级别的 SplashScreen。")
                if !G["flags"].has("tree_jump")
                    G["flags"]["tree_jump"] = 1
                    add_aff("方琪", 3)
                    say("  方琪趴在落地窗上全程围观，隔着玻璃给你鼓掌。（方琪好感+3）")
            else
                say("🚶 你默默退回树干，假装刚才只是在看风景。")
        else
            int r1 = rnd(10)
            if r1 >= 8
                say("  你爬到最高的枝上晃腿。整条街的红瓦白墙都在脚下，环岛线的列车从头顶的管道里掠过。")
            elif r1 >= 5
                say("  方方家后院晾着的毛巾就在隔壁。你大喊了一声『方方——』，那边传来一声『谁啊?!』")
            else
                say("  你在树杈上蹲了一会儿，看廿七（如果它在这儿）在树下打转，然后顺原路溜下去。")
    elif act == "游泳"
        if G["loc"] == "后院"
            if pool_water() < 100
                say("🏊 泳池还是空的——小说里写明了『还没有灌水』。池边过滤控制盒的绿灯一闪一闪，像在等你按。")
                say("  （试试「给泳池灌水」；等不及也可以先去方方家游——他家泳池是满的。）")
            else
                say("🏊 你绕着泳池游了十圈，水凉得刚刚好。戴上泳镜能看见池底一张五方币。")
                if !G["flags"].has("pool_coin")
                    G["flags"]["pool_coin"] = 1
                    G["money"] += 5
                    say("  🪙 你一个猛子扎到底——还真是 5 方币！（+5）")
                else
                    say("  上回那 5 方币的位置你已经背下来了。")
        else
            say("🏊 方方家的泳池是满的！你扑通一声跳进去，电动充气泵上的火烈鸟漂过来撞了你一脸。")
            if G["cat"]["with_you"]
                say("  廿七在航空箱里探出头，用『两脚兽真蠢』的眼神看着你游泳。")
    elif act == "玩沙"
        int r2 = rnd(10)
        if r2 >= 7
            say("🏖 你堆了一座微缩方岛：方岛之眼用漏水的小桶倒模，环岛线是一条绕圈的车辙。")
            say("  你给它起名：『沙之方岛 1.0』。")
        elif r2 >= 4
            say("🏖 你把脚埋进沙子里，再拔出来，再埋进去。经典的快乐，永不褪色。")
        else
            say("🏖 你挖了个深坑，研究了半天坑壁不塌的原理，然后在里面埋了一颗『宝物』。")
        if AND2(G["loc"] == "后院", !G["flags"].has("sand_marble"))
            G["flags"]["sand_marble"] = 1
            give_item("彩色弹珠", 1)
            say("  🌟 挖着挖着，指尖碰到个硬东西——一颗彩色弹珠！（获得：彩色弹珠）")
        if AND2(G["loc"] == "方方后院", !G["flags"].has("ff_sand"))
            G["flags"]["ff_sand"] = 1
            say("  方方从窗户探出头：『你在我家沙坑里挖什么呢？』『考古。』『……哦。』")
    elif act == "灌泳池"
        if pool_water() >= 100
            say("🚿 泳池已经满上了，水面把云映得一格一格的。控制盒绿灯长亮。")
        else
            int nw = pool_water() + 50
            if nw > 100
                nw = 100
            G["flags"]["pool_water"] = nw
            advance(45)
            if nw >= 100
                say("🚿 『哗——』你按下控制盒，水管开始往池子里吐水。45 分钟后，泳池满了！")
                say("  现在可以在自家泳池游泳，榕树横枝上也能玩真的跳水了。")
            else
                say("🚿 你按下控制盒，水位线爬了一半。（再灌一次就满；耗时 45 分钟）")
    elif act == "翻墙"
        if G["loc"] == "方方后院"
            say("🧗 你抓住矮篱笆顶，一撑——落到自家草坪上。熟门熟路。")
            G["loc"] = "后院"
            advance(2)
        else
            advance(2)
            int r3 = rnd(10)
            if r3 <= 6
                say("🧗 你助跑两步，双手扒住篱笆顶，一翻——稳稳落在方方家后院的沙坑边上。")
                say("  两家的矮篱笆在小说里就『只是象征性的』，确实不难翻。")
                G["loc"] = "方方后院"
            elif r3 <= 8
                say("🧗 你翻到一半卡住了——裤腰挂在了篱笆尖上，进退两难。")
                say("  挣扎十秒后你连滚带爬摔进了方方家的花坛。花瓣沾了一头发。")
                G["loc"] = "方方后院"
            else
                say("🧗 你刚撑上篱笆顶，就听见楼下『咔嚓』一声——方方举着相机：『再来一遍！刚才糊了！』")
                G["loc"] = "方方后院"
    elif act == "查信箱"
        if !G["flags"].has("mailbox")
            G["flags"]["mailbox"] = 1
            G["money"] += 10
            say("📬 信箱里有：一张物业通知、一本超市传单，还有妈妈塞的 10 方币『备用金』。（+10）")
        else
            say("📬 空的。方岛-mail 都发手机上了，实体信箱只剩传单的份。")
    elif act == "上大白"
        bool caron = true
        while caron
            print("")
            say("🚙 你拉开车门爬进大白。内饰一股爸爸惯用的薄荷味，后座还塞着方琪的绘本。")
            say("  1. 🛋 躺后座上发呆")
            say("  2. 📻 按喇叭（风险自负）")
            say("  3. 🧃 翻车内储物格")
            say("  4. 🚪 爬出大白")
            ask "＞ "
            str c2 = clean(ans)
            if c2 == "4"
                caron = false
                say("🚪 你从大白里钻出来，顺手把车门关好——爸爸检查车是很勤的。")
            elif c2 == "1"
                say("🛋 后座放平，你躺着看车顶。天窗玻璃外面有一小块天，刚好一格。")
            elif c2 == "2"
                int r4 = rnd(10)
                if r4 >= 5
                    say("📢 『嘀——嘀！！』喇叭声在车库里震得嗡嗡响。")
                    say("  爸爸从玄关探出头：『刘小方！』你光速滑出驾驶座。")
                    add_aff("爸爸", -1)
                else
                    say("📢 你只是轻轻碰了一下，喇叭『嘀』了半声。你僵在原地三秒——没人发现。")
            else
                if c2 == "3"
                    if !G["flags"].has("car_find")
                        G["flags"]["car_find"] = 1
                        give_item("停车券", 1)
                        G["money"] += 8
                        say("🧃 中央扶手缝里：一张旧停车券 + 8 方币硬币。副驾格子里还有半包受潮的山楂片。")
                    else
                        say("🧃 只有半包受潮的山楂片了。你捏了一片，有点软。")
                else
                    say("（在车里就 1-4 这几件事可干。）")
    elif act == "买关东煮"
        if G["money"] >= 8
            G["money"] -= 8
            give_item("关东煮", 1)
            say("🍢 热乎乎的关东煮到手（-8方币）。萝卜是灵魂。")
        else
            say("💰 钱不够。")
    elif act == "买奶茶"
        if G["money"] >= 15
            G["money"] -= 15
            say("🧋 三分糖去冰（-15方币）。快乐到手。")
        else
            say("💰 钱不够。")
    elif act == "看电影"
        int price = 40
        str note = ""
        if G["day"] % 7 == 2
            price = 20
            note = "（今天周二半价！）"
        if G["money"] >= price
            G["money"] -= price
            say("🎬 你看了《方岛奇谈 3》，结尾彩蛋有第 4 部的预告。" + note)
        else
            say("💰 钱不够。")
    elif act == "修电脑"
        if G["pc"]["broken"]
            if G["money"] >= 50
                G["money"] -= 50
                G["pc"]["broken"] = false
                say("🛠 装机小哥：『又双叒是你？删 system 很好玩吗？』（-50方币）电脑复活了。")
            else
                say("💰 修理费 50 方币，你只有 " + str(G["money"]) + "。")
        else
            say("🛠 你的电脑没坏。小哥甚至给你竖了个大拇指。")
    elif act == "钓鱼"
        if G["money"] >= 10
            G["money"] -= 10
            say("🎣 你租了根鱼竿（-10方币），在码头蹲了半小时。")
            int luck = rnd(10)
            if luck >= 7
                G["money"] += 25
                say("  🐟 一条大鱼！卖给排档得了 25 方币。（净赚 15）")
            else
                say("  🐟 三条小鱼苗，你把它们放回了海里。风很舒服。")
        else
            say("💰 租金 10 方币，你掏不出来。")
    elif act == "吃排档"
        if G["money"] >= 20
            G["money"] -= 20
            say("🦞 蒜蓉粉丝蒸扇贝 + 烤生蚝（-20方币）。不远处王大爷的臭豆腐摊飘着香。")
        else
            say("💰 钱不够。")
    elif act == "寄明信片"
        if has_item("明信片")
            G["inv"]["明信片"] -= 1
            G["flags"]["mail"] = G["day"]
            say("📮 你在云端邮筒投出了给自己的明信片：『致未来的刘小方：今天也挺好的。』")
        else
            say("📮 你没带明信片。（商场 5 方币一张）")
    elif act == "拍照"
        if OR2(G["equip"]["手部"] == "相机", has_item("相机"))
            photo("风景不错，廿七（如果带了）非常上镜。")
        else
            say("📷 手机也能拍——但你说要用相机拍才叫拍照。（买一台或装备上）")
    elif act == "放风筝"
        if has_item("风筝")
            say("🪁 风筝上天了！环岛线的列车从头顶掠过，像在跟你赛跑。")
        else
            say("🪁 没风筝。休闲驿站有卖（25方币）。")
    elif act == "泡温泉"
        say("♨️ 你泡进了露天池，火山在不远处冒着一缕白气。")
        if G["cat"]["with_you"]
            say("  廿七在旁边的宠物浅池里划水，店员说它是今晚这池子的明星。")
    elif act == "滑雪"
        if G["cat"]["with_you"]
            if has_item("猫防寒服")
                if !G["flags"].has("cat_snow")
                    G["flags"]["cat_snow"] = 1
                    photo("廿七穿着小羽绒服在雪地里打滚——三脚猫滑雪首发！")
                say("🎿 你和廿七都玩疯了。极光在头顶流动。")
            else
                say("🐱 廿七在航空箱里冻得直哆嗦。先给它买件猫防寒服（冰雪岛大厅 18 方币）。")
        else
            say("🎿 你从中级道滑下来，摔了两次，笑了一路。")
    elif act == "过山车"
        say("🎢 『云霄方环』俯冲的那三秒你进行了短暂的人生回顾。下来后腿是软的。")
    elif act == "海盗船"
        say("⚓ 你坐最后一排，失重感直接拉满。方琪要是看见你叫出声，能笑一年。")
    elif act == "看马戏"
        if G["money"] >= 30
            G["money"] -= 30
            say("🎪 会算术的海狮答对了 8+5，观众席爆发出雷鸣掌声（-30方币）。")
        else
            say("💰 门票 30 方币，钱不够。")
    elif act == "吃自助"
        if G["money"] >= 88
            G["money"] -= 88
            say("🍣 三文鱼、椰子水、现开榴莲（-88方币）。你吃到了方琪的水平。")
        else
            say("💰 88 方币一位，钱不够。")
    elif act == "野餐"
        list snacks = ["面包", "关东煮", "零食大礼包", "臭豆腐", "矿泉水"]
        bool ate = false
        for fid in snacks
            if has_item(fid)
                G["inv"][fid] -= 1
                ate = true
        if ate
            say("🧺 草坪野餐！风、食物、远处的过山车尖叫——康岛标配。")
        else
            say("🧺 你带了野餐垫，但没带吃的。")
    elif act == "吹泡泡"
        if has_item("泡泡机")
            say("🫧 泡泡飞过新城广场，孩子们追着跑。有人问你在哪买的。")
        else
            say("🫧 你对着天空哈了口气。旁边小孩：『叔叔你干嘛？』")
    elif act == "买臭豆腐"
        if G["money"] >= 10
            G["money"] -= 10
            give_item("臭豆腐", 1)
            say("🥢 王大爷：『小方回来啦！多给你加一勺酱。』（-10方币）")
        else
            say("💰 10 方币，大爷也得吃饭。")
    elif act == "读书"
        if !G["flags"].has("lib1")
            G["flags"]["lib1"] = 1
            G["rep"]["学校"] += 1
            say("📚 你在编程区泡了一下午，《CW Script 进阶》看了三章。（学校声望+1）")
        else
            say("📚 你又翻了两章。借书卡快盖满章了。")
    elif act == "跑步"
        if G["equip"]["鞋子"] == "运动鞋"
            say("🏃 运动鞋踩在红色跑道上，你跑出了个人最好配速。")
        else
            say("🏃 你穿着拖鞋跑了两圈，脚后跟表示抗议。（装备运动鞋试试）")
    elif act == "上课"
        int h = hour_now()
        if AND2(h >= 8, h < 16)
            G["rep"]["学校"] += 1
            say("📖 你上了一节课。历史老师讲到雪山，又看了你一眼。（学校声望+1）")
        else
            say("🏫 现在不是上课时间。学校走廊安静得像另一个世界。")
    elif act == "食堂吃饭"
        if G["money"] >= 10
            G["money"] -= 10
            say("🍚 食堂一荤两素（-10方币）。方方要是在这儿，能顺便讲完一部电影。")
        else
            say("💰 钱不够。")
    elif act == "问方舟"
        ask "＞ 你想问方舟什么？"
        str q = clean(ans)
        if q == ""
            say("🤖 方舟：『沉默也是一种答案。』")
        elif q.contains("猫")
            say("🤖 方舟：『猫的胡须通常为 24 根，与三只脚无关。』")
        elif q.contains("廿七")
            say("🤖 方舟：『猫的胡须通常为 24 根，与三只脚无关。』")
        elif q.contains("为什么")
            say("🤖 方舟：『好问题。根据我的数据库，答案是：取决于你下一步做什么。』")
        elif q.contains("?")
            say("🤖 方舟：『好问题。根据我的数据库，答案是：取决于你下一步做什么。』")
        elif q.contains("？")
            say("🤖 方舟：『好问题。根据我的数据库，答案是：取决于你下一步做什么。』")
        else
            say("🤖 方舟：『已记录。我会在我 0.3 秒的一生里认真思考这个问题。』")
    elif act == "观景"
        say("🔭 发射井在脚下沉默。护栏上有一块新牌子：『此处曾升起防护墙』。")
    elif act == "看练车"
        list ns = npcs_here()
        bool fj = false
        for nid in ns
            if nid == "方佳"
                fj = true
        if fj
            say("🚗 方佳深呼吸，起步——转向——停车，一把进位！")
            say("  她摇下车窗，表情史上最冷静：『刚才不算，再来一遍。』")
        else
            say("🚗 空荡荡的训练场。听说方佳约了下周。")
    elif act == "找苏明"
        if G["loc"] == "诊疗室"
            say("🩺 苏明：『来，坐下聊。最近睡得怎么样？』")
            add_aff("苏明", 2)
        else
            say("苏明医生只在诊疗室坐诊。")
    elif act == "偷零花"
        bool done_today = false
        if G["flags"].has("pocket_day")
            if G["flags"]["pocket_day"] == G["day"]
                done_today = true
        if done_today
            say("📱 床头柜你今天已经『打扫』过了。妈妈的零钱罐也需要回血。")
        else
            int h = hour_now()
            int r5 = rnd(10)
            bool caught = false
            if AND2(h >= 9, h < 17)
                if r5 <= 2
                    caught = true
            elif r5 <= 4
                caught = true
            if caught
                add_aff("妈妈", -3)
                say("📱 你刚摸到手机，门口传来一声：『刘小方。』")
                say("  妈妈端着晾衣篮站在那儿：『零花钱要我转给你说一声就行，翻床头柜算怎么回事？』")
                say("  你在道德的深渊边缘火速缩回了手。（妈妈好感-3）")
            else
                if lock_game("妈妈的床头柜")
                    G["flags"]["pocket_day"] = G["day"]
                    int amt = rnd(20) + 15
                    G["money"] += amt
                    say("📱 你摸出妈妈的手机。锁屏密码是你的生日——她一直没改。")
                    say("  你给自己的账号转了 " + str(amt) + " 方币，备注『买文具』，然后把手机按原样放回，连摆放角度都对齐了。")
                    say("  （+" + str(amt) + " 方币 · 每天最多一次 · 被抓到会被没收尊严）")
                else
                    advance(10)
                    say("📱 锁没开。你盯着那个抽屉看了半天，最后把发卡收回口袋。")
                    say("  （把耳朵贴上去，听三根弹子的声音：轻 / 中 / 重。）")
    elif act == "翻床底"
        if !G["flags"].has("bed_find")
            G["flags"]["bed_find"] = 1
            give_item("爸爸的旧手电", 1)
            say("🧰 你趴下去拽床底的工具箱——挺沉。打开：扳手按大小排得整整齐齐，最上层放着一支旧手电。")
            say("  手电后面压着一张纸条：『小方想玩可以，用完放回。——爸』（获得：爸爸的旧手电）")
        else
            say("🧰 工具箱还是那些工具，纸条还是那张纸条。爸爸的秩序感稳定得可怕。")
    elif act == "跳楼"
        say("🪟 你推开窗，楼下是后院。二楼窗户到草坪，说高不高，说低不低——正好是『很刺激但不至于进医院』的高度。")
        if AND2(G["loc"] == "卧室", OR2(pool_water() >= 100, weather_str().contains("雨")))
            if pool_water() >= 100
                say("  而且泳池现在是满的。你盯着水面看了两秒，心跳快了一格。")
                ask "＞ 输 跳泳池 玩一把大的，输 跳草坪 稳妥落地"
                str c3 = clean(ans)
                if c3.contains("泳池")
                    int r6 = rnd(10)
                    if r6 <= 6
                        say("💦 助跑——腾空——『咚！！』正中泳池中心！水花冲天，你在水下睁开眼，看见阳光碎在水面上。")
                        if OR2(has_item("相机"), G["equip"]["手部"] == "相机")
                            photo("二楼窗户→泳池，全程手机慢动作记录。")
                    else
                        say("💦 跳是跳进水里了——只不过抱着过滤控制盒溅起的水花把自己浇了个透。")
                        say("  你爬出泳池，拧了拧衣服，能拧出半瓶水。")
                    G["loc"] = "后院"
                    advance(2)
                    return
            else
                say("  外面下着雨，草坪肯定是软的——也肯定是泥的。")
                ask "＞ 输 跳 就跳，输 算了 关窗"
                str c4 = clean(ans)
                if c4.contains("跳")
                    say("🌧 你跳进泥坑，鞋袜瞬间沦陷。回屋前你把拖鞋藏进了花盆后面——妈妈绝不会顺着泥脚印找到你。")
                    say("  （她当然会。）")
                    G["loc"] = "后院"
                    advance(2)
                    return
                else
                    say("🪟 你关上窗。雨点打在玻璃上，替你把冲动都收好了。")
                    return
        ask "＞ 输 跳 从窗户翻下去，输 算了 关上窗"
        str c5 = clean(ans)
        if c5.contains("跳")
            if weather_str().contains("雨")
                say("🌧 你跳下去，落进泥地。上面说了，这个后果自己认。")
            else
                say("🪟 你撑着窗台一挂，松手——『咚』一声落在草坪上，膝盖一弯卸掉力道，稳稳站住！")
                say("  落地瞬间你环顾四周，确认没人看见，然后悄悄把窗户的事记进了『以后常干』清单。")
            if G["cat"]["spot"] == "后院"
                say("  廿七被你这动静吓得弓成了问号。")
            G["loc"] = "后院"
            advance(2)
        else
            say("🪟 你关上窗。生活嘛，总要留点刺激给明天。")
    elif act == "翻车库"
        if !G["flags"].has("garage_find")
            G["flags"]["garage_find"] = 1
            give_item("旧对讲机", 1)
            G["money"] += 15
            say("🔧 你翻了工具架：螺丝刀、扳手、一卷登山绳。角落纸箱里翻出一对旧对讲机（只活下来一只）和 15 方币零钱。")
            say("  （获得：旧对讲机 · +15 方币）")
        else
            say("🔧 卷帘门底下钻进来一阵风。纸箱里除了旧磁带就是过期的玻璃水。")
    elif act == "翻工具房"
        if !G["flags"].has("tool_find")
            G["flags"]["tool_find"] = 1
            give_item("3D打印小方猫", 1)
            say("🖨 你在工具房里东摸西看。3D打印机还在嗡嗡吐料——周叔叔居然在打一只小猫，缺一条腿的那种。")
            say("  『要拿就拿走，跟周叔说一声就行。』桌上贴着字条。（获得：3D打印小方猫）")
        else
            say("🖨 工具墙按尺寸挂着，3D打印机转着下一个零件。登记本上最新一行是方方的名字，用途写：『机密』。")
    elif act == "翻检修车库"
        if !G["flags"].has("dock_find")
            G["flags"]["dock_find"] = 1
            give_item("旧站牌", 1)
            say("🧰 你侧身挤进检修车库：油压扳手、成排的悬浮模块、一块换下来的旧站牌。")
            say("  你把站牌夹在腋下当纪念品，顺便学会了环岛线列车的两种转弯姿态。（获得：旧站牌）")
        else
            advance(5)
            say("🧰 这次刚摸到门把手，检修员大叔就从车底探出头：『又来了？想学修车就正经报名啊。』")
            say("  你在名册上认真签了个名，被发了一副劳保手套，蹲着看了 5 分钟真活儿。")
    elif act == "丢猫"
        if !G["cat"]["with_you"]
            say("🐱 廿七不在你怀里。先抱上它再谈丢不丢。")
            return
        bool own_pool = AND2(G["loc"] == "后院", pool_water() >= 100)
        bool ff_pool = G["loc"] == "方方后院"
        if OR2(own_pool, ff_pool)
            G["cat"]["with_you"] = false
            G["cat"]["home"] = true
            G["cat"]["spot"] = G["loc"]
            advance(2)
            say("🏊 你拎着廿七的后颈皮（它极不配合），把它举到水面正上方——松手。")
            if rnd(10) <= 7
                say("  『噗通！』廿七砸进水里，四只爪子同时开始疯狂划动，尾巴像螺旋桨。")
                say("  它三秒游到池边爬上来，抖了你一身水，然后蹲在池边舔毛，假装刚才很享受。")
                G["cat"]["mood"] -= 5
                if G["cat"]["mood"] < 0
                    G["cat"]["mood"] = 0
                say("  （廿七心情-5。它记住了。）")
            else
                say("  松手的前一瞬，廿七在你手背上借力一蹬，直接跳上你的肩膀，居高临下地看着水面。")
                say("  ——它根本就没打算下水。你被一只三脚猫耍了。")
            say("  （廿七现在在" + G["loc"] + "，不在你怀里了。）")
            if !G["flags"].has("cat_dunk")
                G["flags"]["cat_dunk"] = 1
                photo("廿七落水瞬间，四爪张开像一只姜黄色海星。")
        else
            say("🏊 这里没有能把它丢下去的水。泳池、泳池，得先有个满水的泳池。")
    elif act == "扔猫上树"
        if !G["cat"]["with_you"]
            say("🐱 廿七不在你怀里。它可能自己就在树上。")
            return
        if OR2(G["loc"] == "后院", G["loc"] == "方方后院")
            G["cat"]["with_you"] = false
            G["cat"]["home"] = true
            G["cat"]["spot"] = G["loc"]
            advance(3)
            say("🌳 你把廿七往榕树最低的枝杈上一送——它四爪立刻扣死树皮。")
            say("  它回头瞪了你一眼，然后一路往上爬，最后蹲在最高那根枝上，尾巴垂下来一晃一晃。")
            say("  （廿七在树上，暂时不肯下来。它心情 " + str(G["cat"]["mood"]) + "/100）")
            if G["cat"]["mood"] >= 60
                say("  过了会儿它自己顺着树干溜下来了，还顺便在树皮上磨了磨爪子。")
                G["cat"]["spot"] = G["loc"]
            else
                say("  你在树下站了很久。它假装没看见你。")
        else
            say("🌳 附近没有树。要找榕树，去后院或者方方家后院。")
    elif act == "丢猫方方"
        if !G["cat"]["with_you"]
            say("🐱 廿七不在你怀里。")
            return
        if OR2(G["loc"] == "方方后院", OR2(G["loc"] == "后院", G["loc"] == "方方前院"))
            G["cat"]["with_you"] = false
            G["cat"]["home"] = false
            G["cat"]["spot"] = "方方后院"
            advance(2)
            say("🏠 你把廿七往方方家后院的沙坑方向一放——它落地，抖毛，环顾四周，然后径直走向方方家的泳池边。")
            say("  方方从窗户探出头：『喂！你怎么又把猫扔我家？！』")
            say("  『它喜欢你家泳池。』『……那倒是。』")
            if G["wild"]["奶盖"]["aff"] >= 40
                say("  奶盖从花丛后走出来，两只猫隔着沙坑对视了三秒，然后一起蹲在池边看水。")
        else
            say("🏠 要把猫丢到方方家，你得先到方方家附近（后院 / 前院 / 方方后院）。")
    elif act == "撬抽屉"
        if G["loc"] == "方方房间"
            fang_drawer()
        else
            say("🗄 这里没有方方的抽屉。他的房间在方方家二楼。")
    elif act == "找野猫"
        wild_search()
    elif act == "吃比多饭"
        if G["money"] >= 12
            G["money"] -= 12
            advance(20)
            say("🍛 咖喱炸鸡饭（-12方币）。咖喱浓得能挂住勺子，炸鸡外壳咔嚓一声。")
            if rnd(10) <= 6
                say("  吃到一半，后巷传来一声猫叫。")
                advance(1)
                wild_search()
            else
                say("  你吃完把餐盘送回回收口。后巷今天很安静，只有风在翻塑料袋。")
        else
            say("💰 一份咖喱炸鸡饭 12 方币。你摸了摸口袋。")
    else
        say("（这个动作在这里做不了。）")

/* ------------------------------------------------------------
/* 十四、事件线（小说事件改编，满足条件自动触发）
/* ------------------------------------------------------------
fn check_events()
    /* 1 廿七的猫砂抗议
    if AND2(!G["flags"].has("ev1"), G["cat"]["litter"] >= 90)
        G["flags"]["ev1"] = 1
        G["phone"]["unread"] += 1
        say("🧹 事件【廿七的抗议】：猫砂盆的气味已经形成了存在感。方琪发来消息：『哥！猫砂！猫！！砂！！』")
    /* 2 挨饿的猫
    if AND2(!G["flags"].has("ev2"), AND2(G["cat"]["hunger"] >= 95, G["cat"]["home"]))
        G["flags"]["ev2"] = 1
        G["phone"]["unread"] += 1
        say("🍚 事件【挨饿的猫】：方佳发来消息：『廿七饿了。别装死，猫粮超市有售。』")
    /* 3 超市大乱斗（妈妈在场）
    if AND2(G["loc"] == "商场4F超市", !G["flags"].has("ev3"))
        list ns = npcs_here()
        for nid in ns
            if AND2(nid == "妈妈", !G["flags"].has("ev3"))
                G["flags"]["ev3"] = 1
                G["money"] += 10
                add_aff("妈妈", 3)
                say("🛒 事件【超市大乱斗】：你帮妈妈扛了三大袋战利品。（工资+10方币，妈妈好感+3）")
    /* 4 神秘零件（方方在场）
    if AND2(!G["flags"].has("ev4"), has_item("神秘零件"))
        list ns2 = npcs_here()
        for nid2 in ns2
            if AND2(nid2 == "方方", !G["flags"].has("ev4"))
                G["flags"]["ev4"] = 1
                G["pc"]["games"] += 1
                G["quest"] = "🔧 装机大计：显卡800 + CPU600 + 散热器150（数码港·装机店），别忘买散热器"
                say("🔧 事件【方方的眼睛】：方方看到神秘零件，倒吸一口气：『这、这是限量供电模块！送你了——条件是装好了先让我开机！』")
                say("  他当场帮你把电脑调到了最佳状态。")
    /* 5 杀方案（玲阅在方方厨房做饭）
    if AND2(G["loc"] == "方方厨房", !G["flags"].has("ev5"))
        list ns3 = npcs_here()
        for nid3 in ns3
            if AND2(nid3 == "玲阅", !G["flags"].has("ev5"))
                G["flags"]["ev5"] = 1
                say("🍳 事件【杀方案】：玲阅端出一盘『炒饭』，颜色是科学无法解释的。")
                say("  你怀着对科学的敬意尝了一口……居然，是甜的。")
                add_aff("玲阅", 2)
    /* 6 环岛线烟花（傍晚的海滨公园，每天一次）
    if AND2(G["loc"] == "海滨公园", AND2(hour_now() >= 19, AND2(hour_now() <= 21, !G["flags"].has("ev6_" + str(G["day"])))))
        G["flags"]["ev6_" + str(G["day"])] = 1
        say("🎆 事件【环岛线烟花】：海湾上空炸开烟花，倒挂的列车从光里穿过。")
        if G["equip"]["配饰"] == "隔音耳塞"
            say("  你戴着隔音耳塞——烟花成了默片。路人看你笑到打鸣。")
    /* 7 旧墟低语
    if AND2(G["loc"] == "旧墟·尖塔群", !G["flags"].has("ev7"))
        G["flags"]["ev7"] = 1
        G["quest"] = "📿 去地牢·壁画厅，看看旧王国到底发生了什么"
        say("📿 事件【旧墟低语】：风穿过倒塌的尖塔，蓝石碎屑微微发光。你脖子上的围巾轻轻亮起，像在回应什么。")
        say("  （天空王国似乎还记得你。）")
    /* 8 雪山试炼
    if AND2(G["loc"] == "雪山乱石滩", !G["flags"].has("ev8"))
        G["flags"]["ev8"] = 1
        give_item("蓝石碎片", 1)
        G["quest"] = "💎 把蓝石碎片带回去给方方看看"
        say("💎 事件【雪山试炼】：悬浮的蓝石在乱石间漂着。你捡起一小块——它在你掌心轻轻发亮。（获得：蓝石碎片）")
        say("  方方看到这个会疯的。")

/* ------------------------------------------------------------
/* 十五、存档 / 读档（writefile / readfile · F5 桌面内核）
/* ------------------------------------------------------------
fn save_game()
    str s = "T=" + str(G["tmin"]) + "," + str(G["day"]) + "," + str(G["money"]) + "," + G["loc"] + "," + str(G["seed"]) + "," + str(G["steps"]) + "," + str(G["phone"]["batt"]) + "," + str(G["phone"]["unread"]) + "\n"
    str inv = "I="
    for id in G["inv"].keys()
        if G["inv"][id] > 0
            inv = inv + id + ":" + str(G["inv"][id]) + "|"
    s = s + inv + "\n"
    str eq = "Q="
    list slots = ["上衣", "背包", "手部", "配饰", "鞋子"]
    for slot in slots
        eq = eq + slot + ":" + G["equip"][slot] + "|"
    s = s + eq + "\n"
    s = s + "C=" + str(G["cat"]["home"]) + "," + str(G["cat"]["with_you"]) + "," + str(G["cat"]["hunger"]) + "," + str(G["cat"]["clean"]) + "," + str(G["cat"]["mood"]) + "," + str(G["cat"]["litter"]) + "," + G["cat"]["spot"] + "\n"
    str aff = "A="
    for nid in G["aff"].keys()
        aff = aff + nid + ":" + str(G["aff"][nid]) + "|"
    s = s + aff + "\n"
    str fl = "F="
    for fkey in G["flags"].keys()
        fl = fl + fkey + ":" + str(G["flags"][fkey]) + "|"
    s = s + fl + "\n"
    s = s + "P=" + str(G["pc"]["broken"]) + "," + str(G["pc"]["diary"]) + "," + str(G["pc"]["games"]) + "\n"
    s = s + "R=" + str(G["rep"]["学校"]) + "," + str(G["rep"]["社区"]) + "\n"
    str al = "AL="
    for p in G["album"]
        al = al + p + "｜"
    s = s + al + "\n"
    str wl = "W="
    for wnm in G["wild"].keys()
        wl = wl + wnm + ":" + G["wild"][wnm]["loc"] + ":" + str(G["wild"][wnm]["aff"]) + ":" + str(G["wild"][wnm]["carry"]) + "|"
    s = s + wl + "\n"
    str wd = "N="
    for wid in G["wander"].keys()
        wd = wd + wid + ":" + G["wander"][wid] + "|"
    s = s + wd + "\n"
    SAVE_DATA = s
    try
        writefile("方岛物语存档.txt", s)
        say("💾 已保存到 方岛物语存档.txt（" + clock_str() + " · " + G["loc"] + "）。")
    catch e
        say("💾 已存好（当前运行模式不支持写文件，存档暂存在内存里，本次运行内用『读档』即可恢复）。")

fn load_game()
    str data = ""
    try
        data = readfile("方岛物语存档.txt")
    catch e
        data = ""
    if data == ""
        data = SAVE_DATA
    if data == ""
        say("（没有找到存档。）")
        return
    G["inv"] = {}
    G["equip"] = {}
    G["aff"] = {}
    G["flags"] = {}
    G["album"] = []
    G["visited"] = {}
    G["recent"] = []
    boot_wild()
    G["wander"] = {}
    for ln in data.split("\n")
        if ln != ""
            kv = ln.split("=")
            str k = kv[0]
            str v = ""
            if kv.len() > 1
                v = kv[1]
            if k == "T"
                p = v.split(",")
                G["tmin"] = p[0].trim().to_int()
                G["day"] = p[1].trim().to_int()
                G["money"] = p[2].trim().to_int()
                G["loc"] = p[3].trim()
                G["seed"] = p[4].trim().to_int()
                G["steps"] = p[5].trim().to_int()
                G["phone"] = {"batt": p[6].trim().to_int(), "unread": p[7].trim().to_int(), "last": "主页"}
            elif k == "I"
                ps = v.split("|")
                for pair in ps
                    if pair != ""
                        pr = pair.split(":")
                        G["inv"][pr[0]] = pr[1].trim().to_int()
            elif k == "Q"
                ps2 = v.split("|")
                for pair2 in ps2
                    if pair2 != ""
                        pr2 = pair2.split(":")
                        G["equip"][pr2[0]] = pr2[1]
            elif k == "C"
                p3 = v.split(",")
                str cspot = "猫窝角"
                if p3.len() > 6
                    cspot = p3[6].trim()
                G["cat"] = {"name": "廿七", "home": p3[0].trim() == "true", "with_you": p3[1].trim() == "true", "hunger": p3[2].trim().to_int(), "clean": p3[3].trim().to_int(), "mood": p3[4].trim().to_int(), "litter": p3[5].trim().to_int(), "spot": cspot}
            elif k == "A"
                ps4 = v.split("|")
                for pair4 in ps4
                    if pair4 != ""
                        pr4 = pair4.split(":")
                        G["aff"][pr4[0]] = pr4[1].trim().to_int()
            elif k == "F"
                ps5 = v.split("|")
                for pair5 in ps5
                    if pair5 != ""
                        pr5 = pair5.split(":")
                        G["flags"][pr5[0]] = pr5[1].trim().to_int()
            elif k == "P"
                p6 = v.split(",")
                G["pc"] = {"broken": p6[0].trim() == "true", "diary": p6[1].trim().to_int(), "games": p6[2].trim().to_int()}
            elif k == "R"
                p7 = v.split(",")
                G["rep"] = {"学校": p7[0].trim().to_int(), "社区": p7[1].trim().to_int()}
            elif k == "AL"
                ps8 = v.split("｜")
                for pic in ps8
                    if pic != ""
                        G["album"].push(pic)
            elif k == "W"
                ps9 = v.split("|")
                for pair9 in ps9
                    if pair9 != ""
                        pr9 = pair9.split(":")
                        if pr9.len() > 3
                            G["wild"][pr9[0]] = {"loc": pr9[1].trim(), "aff": pr9[2].trim().to_int(), "carry": pr9[3].trim() == "true"}
            elif k == "N"
                ps10 = v.split("|")
                for pair10 in ps10
                    if pair10 != ""
                        pr10 = pair10.split(":")
                        if pr10.len() > 1
                            G["wander"][pr10[0]] = pr10[1].trim()
    say("💾 读档成功！第" + str(G["day"]) + "天 " + clock_str() + " · " + G["loc"])
    describe(false)

/* ------------------------------------------------------------
/* 十六、菜单 / 指令解析 / 主循环
/* ------------------------------------------------------------
fn build_menu()
    G["menu"] = []
    list es = EDGES[G["loc"]]
    for e in es
        if e[2] == 0
            G["menu"].push(["🚶 去 " + e[0] + "（步行 " + str(e[1]) + " 分钟）", "go", e[0]])
    bool hasrail = false
    for e2 in es
        if e2[2] == 1
            hasrail = true
    if hasrail
        G["menu"].push(["🚈 乘坐空铁", "rail", ""])
    list ns = npcs_here()
    for nid in ns
        G["menu"].push(["💬 和" + NPCS[nid]["name"] + "聊天", "talk", nid])
    if ACTMAP.has(G["loc"])
        list acts = ACTMAP[G["loc"]]
        for a in acts
            G["menu"].push([a[0], "act", a[1]])
    bool catnear = false
    if G["cat"]["with_you"]
        catnear = true
    if G["cat"]["spot"] == G["loc"]
        catnear = true
    if catnear
        G["menu"].push(["🐱 廿七", "cat", ""])
    bool wildnear = false
    if wild_carried() != ""
        wildnear = true
    list wl = wild_at_here()
    if wl.len() > 0
        wildnear = true
    if wildnear
        G["menu"].push(["🐈 野猫", "wild", ""])
    if SHOPSTOCK.has(G["loc"])
        G["menu"].push(["🛒 逛商店", "shop", ""])
    G["menu"].push(["📱 手机", "phone", ""])
    G["menu"].push(["🎒 物品栏", "inv", ""])
    G["menu"].push(["👔 装备栏", "equip", ""])
    G["menu"].push(["👀 环顾四周", "look", ""])
    G["menu"].push(["💾 存档", "save", ""])
    G["menu"].push(["📥 读档", "load", ""])
    G["menu"].push(["📖 帮助", "help", ""])

fn dispatch(str kind, str arg)
    if kind == "go"
        travel_walk(arg)
    elif kind == "rail"
        rail_menu()
    elif kind == "talk"
        npc_menu(arg)
    elif kind == "phone"
        phone_menu()
    elif kind == "cat"
        cat_menu()
    elif kind == "wild"
        wild_menu()
    elif kind == "shop"
        shop_menu()
    elif kind == "inv"
        inv_menu()
    elif kind == "equip"
        equip_menu()
    elif kind == "look"
        describe(true)
    elif kind == "save"
        save_game()
    elif kind == "load"
        load_game()
    elif kind == "help"
        help()
    elif kind == "act"
        do_action(arg)

fn help()
    print("")
    say("📖 指南（开放世界，怎么玩都行）")
    say("  · ⚠ 玩本游戏要用【调试（F6）】启动（F5 编译模式没有键盘输入）")
    say("  · 直接输编号选菜单；也可以打字下指令：")
    say("  · 去卧室 / 去商场 / 去康岛 —— 去任何地方（走不到会提示坐空铁）")
    say("  · 看手机 / 用电脑 / 撸猫 / 喂猫 / 铲屎 —— 日常")
    say("  · 物品 / 装备 / 存档 / 读档 —— 系统")
    say("  · 和XX聊天（对方在场时）—— 面对面聊天，符合各自性格")
    say("  · 使用面包 / 装备运动鞋 —— 物品交互")
    say("  · 空铁：1号线（社区-中央-商场-数码港） 2号线（社区-学院-训练场-能源-医疗） 环岛线（中央-海滨-码头）")
    say("  · 跨岛：中央车站 → 康岛（240分钟） / 天空王国（600分钟）")
    say("  · 带猫跑路：找到廿七（它现在会乱跑：窝里/床上/方佳基地/方方家/公园）→ 带上它 → 三岛任你闯")
    say("  · 家里就能疯：爬榕树（泳池灌满可跳水）、从二楼窗户跳下去、玩沙堆、给泳池灌水、")
    say("    爬进车库的大白里按喇叭、翻爸妈床头柜转零花（会被抓）、每个车库都能翻")
    say("  · 去方方家：正门出去沿街走，或从后院翻矮篱笆（小说里的『象征性』篱笆）")
    say("  · 物品栏只有 10 格（双肩包 13 格）。手机/钥匙/交通卡不占格，其他每样占 1 格。")
    say("  · 廿七占 5 格：抱着它就能到处逛，也能丢进泳池、扔上榕树、丢进方方家。")
    say("  · 野猫：比多饭后巷、栖霞街道、社区公园、便利店、休闲驿站会随机刷猫。")
    say("    先摸、喂，把好感养到 60 才抱得动；野猫好感低时会挠你。抱回家能看它和廿七打一场。")
    say("  · 撬锁：妈妈的床头柜、方方的抽屉都是三簧锁——听三声，输 轻 / 中 / 重。")
    say("  · 方方会随机刷新，说不定一开门他就在你家客厅。")
    say("  · 电脑可以搞崩（磁盘清理有风险），修电脑去数码港·装机店")

fn resolve_alias(str t)
    for pair in ALIAS
        if pair[0] == t
            return pair[1]
    str best = ""
    int bl = 0
    for pair2 in ALIAS
        if AND2(pair2[0] != "", t.contains(pair2[0]))
            int alen = pair2[0].len()
            if alen > bl
                bl = alen
                best = pair2[1]
    return best

fn cat_gate()
    bool ok = false
    if G["cat"]["with_you"]
        ok = true
    if G["cat"]["spot"] == G["loc"]
        ok = true
    if ok
        cat_menu()
    else
        say("廿七不在附近——它最近学会了乱跑：猫窝、客厅、后院、你的床上、方佳的秘密基地、方方家后院、社区公园，都有人目击过。")
        say("（它饿了会自己回猫窝角。多走走总能撞见。）")

fn shop_gate()
    if SHOPSTOCK.has(G["loc"])
        shop_menu()
    else
        say("这里没店。便利店 / 驿站 / 商场 / 数码港 / 超市都能买。")

fn find_npc()
    list ns = npcs_here()
    if ns.len() > 0
        npc_menu(ns[0])
    else
        say("这里没别人。想聊就打开手机（方聊）。")

fn handle_cmd(str cmd)
    if cmd == ""
        return
    for i in range(G["menu"].len())
        if cmd == str(i + 1)
            list opt = G["menu"][i]
            dispatch(opt[1], opt[2])
            return
    if AND2(cmd.contains("去"), cmd.len() > 1)
        str loc = resolve_alias(cmd.replace("去", ""))
        if loc != ""
            travel_walk(loc)
            return
    /* 动作指令优先于地名别名（否则「灌泳池」会被「泳池」别名劫持成走路）
    if OR2(cmd.contains("爬树"), cmd.contains("爬榕树"))
        do_action("爬树")
        return
    if OR2(cmd.contains("玩沙"), cmd.contains("挖沙"))
        do_action("玩沙")
        return
    if OR2(cmd.contains("灌水"), cmd.contains("灌泳池"))
        do_action("灌泳池")
        return
    if cmd.contains("翻墙")
        do_action("翻墙")
        return
    if OR2(cmd.contains("床头柜"), cmd.contains("偷零花"))
        do_action("偷零花")
        return
    if AND2(cmd.contains("扔"), cmd.contains("树"))
        do_action("扔猫上树")
        return
    if OR2(cmd.contains("丢猫方方"), AND2(cmd.contains("丢"), cmd.contains("方方")))
        do_action("丢猫方方")
        return
    if OR2(cmd.contains("丢猫"), cmd.contains("扔猫"))
        do_action("丢猫")
        return
    if OR2(cmd.contains("撬"), cmd.contains("抽屉"))
        do_action("撬抽屉")
        return
    if OR2(cmd.contains("野猫"), cmd.contains("摸猫"))
        list wl2 = wild_at_here()
        if OR2(wild_carried() != "", wl2.len() > 0)
            wild_menu()
        else
            wild_search()
        return
    if AND2(cmd.contains("比多饭"), !cmd.contains("去"))
        do_action("吃比多饭")
        return
    if cmd.contains("跳")
        do_action("跳楼")
        return
    str loc2 = resolve_alias(cmd)
    if loc2 != ""
        travel_walk(loc2)
        return
    if OR2(cmd.contains("手机"), cmd.contains("电话"))
        phone_menu()
    elif cmd.contains("空铁")
        rail_menu()
    elif cmd.contains("电脑")
        if OR2(G["loc"] == "卧室", G["loc"] == "楼梯下暗门")
            pc_menu()
        else
            say("这里没有你的电脑。（卧室书桌 / 秘密基地有）")
    elif cmd.contains("猫")
        cat_gate()
    elif cmd.contains("廿七")
        cat_gate()
    elif cmd.contains("装备")
        equip_menu()
    elif cmd.contains("物品")
        inv_menu()
    elif cmd.contains("背包")
        inv_menu()
    elif cmd.contains("东西")
        inv_menu()
    elif cmd.contains("商店")
        shop_gate()
    elif cmd.contains("买")
        shop_gate()
    elif cmd.contains("存档")
        save_game()
    elif cmd.contains("保存")
        save_game()
    elif cmd.contains("读档")
        load_game()
    elif cmd.contains("读取")
        load_game()
    elif cmd.contains("睡")
        do_sleep()
    elif cmd.contains("看")
        describe(true)
    elif cmd.contains("环顾")
        describe(true)
    elif cmd.contains("观察")
        describe(true)
    elif cmd.contains("帮助")
        help()
    elif cmd.contains("指令")
        help()
    elif cmd == "help"
        help()
    elif cmd == "？"
        help()
    elif cmd.contains("聊")
        find_npc()
    elif cmd.contains("找")
        find_npc()
    else
        say("你盯着空气想了想，什么也没发生。（输 帮助 看看能干嘛）")

fn game_loop()
    bool on = true
    while on
        G["turn"] += 1
        check_events()
        print("")
        rule()
        hud()
        describe(false)
        if G["quest"] != ""
            say("📌 " + G["quest"])
        build_menu()
        print("  你可以：")
        for i in range(G["menu"].len())
            print("   " + str(i + 1) + ". " + G["menu"][i][0])
        ask "＞ 输入编号或指令（帮助=指南）"
        str cmd = clean(ans)
        handle_cmd(cmd)

fn title_screen()
    print("  ╔════════════════════════════════════════════╗")
    print("  ║          小方趣生活 · 方岛物语              ║")
    print("  ║     文字开放世界 · 方岛/康岛/天空王国        ║")
    print("  ╚════════════════════════════════════════════╝")
    print("")
    say("数字选项 + 自由指令。这个世界记住你的每一个选择。")
    say("⚠ 运行方式：点工具栏【调试（F6 · 解释执行）】再点【继续（F8）】。")
    say("⚠ 若本窗口一闪而过就结束 = 你开成了【运行（F5）】——它没有键盘输入，玩不了。")
    bool on = true
    while on
        say("  1. 开始新生活   2. 操作指南   3. 制作说明")
        ask "＞ "
        str c = clean(ans)
        if c == "1"
            on = false
            if !G["flags"].has("intro")
                G["flags"]["intro"] = 1
                print("")
                say("第 1 天 · 早上 8:30 · 栖霞社区 17 号")
                say("你在自己的床上醒来。窗外榕树上有鸟叫，隔壁方方的后院传来拆东西的动静。")
                say("今天没有非做不可的事——这座岛，连同康岛、天空王国，都是你的。")
                G["quest"] = "📱 手机里有 2 条未读消息，先看看手机"
                say("（提示：输 手机 看看，或直接输数字选菜单。）")
        elif c == "2"
            help()
        elif c == "3"
            say("《方岛物语》—— 基于《小方趣生活》1-2 与《方之旅途》共 124 章改编。")
            say("  CW Script 编写 · Float IDE 内核运行 · Eliza 对话引擎")
            say("  三岛 95+ 场景 · 空铁 1/2号线+环岛线+跨岛真空管道 · 步行网状路网（处处有第二条路）")
        else
            say("（输 1 / 2 / 3。）")

