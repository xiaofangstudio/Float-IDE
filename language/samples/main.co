/* ------------------------------------------------------------
/* 五、NPC 数据
/* ------------------------------------------------------------
dict NPCS = {}

fn N(id, name, desc, home, wake, sleep, dayloc, dayfrom, dayto, gift)
    NPCS[id] = {"name": name, "desc": desc, "home": home, "wake": wake, "sleep": sleep, "dayloc": dayloc, "dayfrom": dayfrom, "dayto": dayto, "gift": gift}

fn build_npcs()
    N("方方", "周方方", "硬件天才+吃货+点子王，你的死党。看到电子垃圾眼睛会发光。", "方方房间", 9, 24, "教室", 8, 16, "神秘零件")
    N("玲阅", "周玲阅", "方方的姐姐，大学生。温柔书卷气，厨艺毁灭者，舞姿惊艳。", "玲阅房间", 7, 23, "生物实验室", 9, 17, "编程书")
    N("方佳", "刘方佳", "23岁姐姐。冷静能干生物向学霸，驾技灾难现场制造者。", "方佳房间", 7, 23, "生物实验室", 9, 18, "编程书")
    N("方琪", "刘方琪", "6岁妹妹。粉色蝴蝶结永动机，一天能问一百个为什么。", "方琪房间", 8, 21, "社区公园", 10, 17, "椰子水")
    N("妈妈", "妈妈", "务实温柔，掌管厨房与零花钱审批。", "厨房", 7, 22, "商场4F超市", 10, 18, "臭豆腐")
    N("爸爸", "爸爸", "工程师，工具房常客，沉默但靠谱。", "爸妈主卧", 7, 23, "能源中心·地面", 9, 18, "神秘零件")
    N("苏明", "苏明医生", "雪山救援军医。说话温和，擅长在闲聊里帮你松开心里的结。", "诊疗室", 9, 18, "诊疗室", 9, 18, "臭豆腐")
    N("小雅", "小雅", "方琪的好朋友，软萌，随身带贴纸。", "社区公园", 9, 19, "社区公园", 9, 19, "泡泡机")
    N("王大爷", "王大爷", "云下集市臭豆腐摊主，方岛人称『豆腐王』。", "海鲜排档", 10, 21, "云下集市", 10, 21, "臭豆腐")

fn npc_at(nid)
    dict n = NPCS[nid]
    /* 随机刷新：方方可能突然出现在任何地方（甚至你家客厅）
    if G["wander"].has(nid)
        return G["wander"][nid]
    int h = hour_now()
    if OR2(h < n["wake"], h >= n["sleep"])
        return n["home"]
    if AND2(h >= n["dayfrom"], h < n["dayto"])
        return n["dayloc"]
    return n["home"]

fn npcs_here()
    list out = []
    for nid in NPCS.keys()
        if npc_at(nid) == G["loc"]
            out.push(nid)
    return out

/* ------------------------------------------------------------
/* 六、方聊 Eliza 引擎
/* ------------------------------------------------------------
list ELIZA = []

fn R(keys, r1, r2, r3)
    ELIZA.push({"keys": keys, "r": [r1, r2, r3]})

fn build_eliza()
    R("你好|在吗|hi|hello", "在呢在呢，怎么啦？", "哟，稀客！", "嗯？我听着呢。")
    R("吃|饭|饿|零食", "说到吃的我就来劲了！我刚发现一家新炸鸡！", "你请客我就去。", "饿的话……要不要来我家翻零食？")
    R("游戏|玩|联机", "上号！就现在！", "今晚八点，不见不散。", "别提了，昨天连跪五把。")
    R("猫|廿七", "廿七！它的三只脚走路超稳的好吧！", "下次带它来，我给它留了小鱼干。", "猫比我早起，服。")
    R("电脑|装机|显卡|编程|代码", "科技改变生活，兄弟。", "你那机器要是还差零件，二手摊蹲蹲看。", "编程这块，你是有点天赋在身上的。")
    R("空铁|去哪|出门|旅行", "要出门？带我一个！", "环岛线的风景永远看不腻。", "外面天气不错，走走走。")
    R("学校|作业|考试|上课", "别提作业，提了我也不会。", "你可是名人，帮我签个名呗。", "数学作业借我……参考一下？")
    R("难过|烦|累|害怕", "怎么了？跟我说说。", "走，出去转转，我请奶茶。", "有我在，怕啥。")
    R("钱|方币|打工", "我最近也穷，咱俩加起来勉强是个富裕户。", "码头搬鱼筐，一小时8币，干不干？", "省着点花，兄弟。")
    R("再见|拜拜|晚安", "拜拜，明天见！", "晚安，做个好梦。", "去吧去吧，记得回消息。")
    R("方岛|康岛|天空王国", "方岛永远的神。康岛嘛……等我攒够钱。", "天空王国啊……有点想回看看。", "这地方，越待越喜欢。")
    R("爸妈|姐姐|妹妹|哥", "你家人真好，我妈都拿你当榜样（真的）。", "姐姐大人最近咋样？还撞车吗？", "替我向玲阅姐姐问好——算了别提做饭。")

fn eliza_pick(list pool)
    int i = rnd(pool.len()) - 1
    return pool[i]

fn eliza_reply(str nid, str text)
    str base = ""
    for rule in ELIZA
        list ks = rule["keys"].split("|")
        bool hit = false
        for k in ks
            if text.contains(k)
                hit = true
        if hit
            base = eliza_pick(rule["r"])
    if base == ""
        int mood = rnd(3)
        if mood == 1
            base = "嗯……这个我还真没想过。你再多说点？"
        if mood == 2
            base = "哈哈哈，你这话题跳得比环岛线还快。"
        if mood == 3
            base = "说起来，你最近都在忙啥呀？"
    /* 性格染色
    if nid == "方方"
        base = base + " （方方发来一个🤖表情）"
    if nid == "方琪"
        base = "哥！" + base
    if nid == "方佳"
        base = "……" + base + "（她顺手发来一份《时间管理建议》）"
    if nid == "玲阅"
        base = base + "（她发来一个温柔的笑脸）"
    if nid == "妈妈"
        base = base + " 记得吃饭。"
    if nid == "爸爸"
        base = "嗯。" + base
    if nid == "苏明"
        base = base + " 最近睡眠怎么样？"
    /* 记忆
    if G["chatmem"].has(nid)
        G["chatmem"][nid] = G["chatmem"][nid] + "｜" + text
    else
        G["chatmem"][nid] = text
    return base

