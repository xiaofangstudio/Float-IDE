/* ============================================================
/* 《小方趣生活：方岛物语》 文字开放世界游戏
/* 语言：CW Script（Float IDE）· 引擎：Rust 内核 F5
/* 素材：《小方趣生活》1+2、《方之旅途》逐章扒取
/* 操作：数字选项 + 自由文字指令（去卧室 / 看手机 / 撸猫 …）
/* ============================================================

/* ------------------------------------------------------------
/* 一、全局状态（全部装进字典 G，函数内可读写）
/* ------------------------------------------------------------
dict G = {}
str SAVE_DATA = ""

fn boot_state()
    G["tmin"] = 8 * 60 + 30
    G["day"] = 1
    G["money"] = 50
    G["loc"] = "卧室"
    G["seed"] = 7919 * 13 + 104729
    G["inv"] = {"手机": 1, "家门钥匙": 1, "交通卡": 1, "面包": 2, "矿泉水": 1, "编程书": 1}
    G["equip"] = {"上衣": "居家服", "背包": "无", "手部": "无", "配饰": "无", "鞋子": "拖鞋"}
    G["flags"] = {}
    G["aff"] = {"方佳": 50, "方琪": 60, "方方": 65, "玲阅": 55, "廿七": 40, "苏明": 30, "小雅": 30, "妈妈": 50, "爸爸": 50, "王大爷": 20}
    G["rep"] = {"学校": 5, "社区": 5}
    G["cat"] = {"name": "廿七", "home": true, "with_you": false, "hunger": 30, "clean": 80, "mood": 70, "litter": 70, "spot": "猫窝角"}
    G["wander"] = {}
    boot_wild()
    G["phone"] = {"batt": 85, "unread": 2, "last": "主页"}
    G["chatmem"] = {}
    G["chatrot"] = {}
    G["pc"] = {"broken": false, "diary": 0, "games": 0}
    G["menu"] = []
    G["album"] = []
    G["quest"] = ""
    G["weather"] = 0
    G["steps"] = 0
    G["visited"] = {}
    G["recent"] = []
    G["theme"] = "深色"
    G["turn"] = 0

fn int rnd(n)
    G["seed"] = (G["seed"] * 48271) % 2147483647
    return int(G["seed"] % n) + 1

fn int hour_now()
    return (G["tmin"] % 1440) // 60

fn int minute_now()
    return (G["tmin"] % 1440) % 60

fn clock_str()
    int h = hour_now()
    int m = minute_now()
    str hs = str(h)
    if h < 10
        hs = "0" + hs
    str ms = str(m)
    if m < 10
        ms = "0" + ms
    return "第" + str(G["day"]) + "天 " + hs + ":" + ms

fn weather_str()
    int w = (G["day"] * 7 + 3) % 4
    if w == 0
        return "晴 ☀"
    if w == 1
        return "多云 ⛅"
    if w == 2
        return "小雨 🌧"
    return "大风 🌬"

fn advance(int mins)
    G["tmin"] += mins
    G["steps"] += 1
    while G["tmin"] >= 1440
        G["tmin"] -= 1440
        G["day"] += 1
        G["phone"]["batt"] -= 10
        if G["phone"]["batt"] < 5
            G["phone"]["batt"] = 5
    int cat_hunger = G["cat"]["hunger"] + (mins // 30)
    if cat_hunger > 100
        cat_hunger = 100
    G["cat"]["hunger"] = cat_hunger
    if mins >= 30
        G["cat"]["litter"] += mins // 60
        if G["cat"]["litter"] > 100
            G["cat"]["litter"] = 100
    /* 廿七会乱跑：时间过去越久，越可能换地方趴着
    if AND2(mins >= 45, G["cat"]["with_you"] == false)
        if rnd(3) == 1
            cat_roam()
    /* 野猫也在社区里到处刷新
    if mins >= 40
        if rnd(2) == 1
            wild_roam()
    /* 方方也会随机刷新：可能在任何地方，甚至你家客厅
    if mins >= 30
        if rnd(3) == 1
            npc_roam()

fn npc_roam()
    list spots = ["方方房间", "方方后院", "工具房", "方方客厅", "社区公园", "便利店", "比多饭", "商场3F美食广场", "教室", "客厅"]
    G["wander"]["方方"] = spots[rnd(spots.len()) - 1]

fn cat_roam()
    /* 猫会随机刷新位置：窝里、客厅、后院、前院、你的床上、方佳的基地、方方家、公园
    list spots = ["猫窝角", "客厅", "后院", "前院", "卧室", "楼梯下暗门", "方方后院", "社区公园"]
    if G["cat"]["hunger"] > 70
        G["cat"]["spot"] = "猫窝角"
    else
        G["cat"]["spot"] = spots[rnd(spots.len()) - 1]
    if OR2(G["cat"]["spot"] == "方方后院", G["cat"]["spot"] == "社区公园")
        G["cat"]["home"] = false
    else
        G["cat"]["home"] = true

fn int pool_water()
    if G["flags"].has("pool_water")
        return G["flags"]["pool_water"]
    return 0

fn hud()
    print("┌──────────────────────────────────────────┐")
    print("│ " + clock_str() + " · " + weather_str() + " · " + str(G["money"]) + " 方币 · 📱" + str(G["phone"]["batt"]) + "% · ✉" + str(G["phone"]["unread"]) + " │")
    print("└──────────────────────────────────────────┘")

fn say(t)
    print("  " + t)

fn rule()
    print("────────────────────────────────────────────")

/* ------------------------------------------------------------
/* 二、地点数据库 LOCS：id → {area, desc}
/*     EDGES：id → [[邻居, 步行分钟, 是否空铁轨], ...]
/* ------------------------------------------------------------
dict LOCS = {}
dict EDGES = {}

fn L(id, area, desc)
    LOCS[id] = {"area": area, "desc": desc}

fn E(a, b, mins, rail)
    if !EDGES.has(a)
        EDGES[a] = []
    if !EDGES.has(b)
        EDGES[b] = []
    EDGES[a].push([b, mins, rail])
    EDGES[b].push([a, mins, rail])

fn build_world()
    /* ▌小方家（栖霞社区17号 双层复式）
    L("卧室", "小方家", "你的房间，朝南。新旧两张床并排（旧的那张是从天空王国搬来的），书桌上摊着《CW Script 入门》，手机充电器插在插座上，书桌另一头摆着一台台式电脑，衣柜靠墙。窗外能看见榕树和方方的后院。")
    L("方琪房间", "小方家", "满屋粉色。方琪的蝴蝶结挂了一整面墙，桌上摆着水宝宝孵化屋，地上散落绘本和蜡笔。空气里有草莓味。")
    L("爸妈主卧", "小方家", "大床、梳妆台、一盆绿萝。阳台上晾着衣服，爸爸的旧工具箱塞在床底。")
