/* 16 高级指针 —— Copper
/* 多级指针、双指针原地反转、arena（内存池）——指针真正开始干活的地方。
/* 注释只能用 --（// 是整除运算符）。

/* ① 多级指针：pp 指向 p，p 指向 x
int x = 7
ptr p = &x
ptr pp = &p
print("**pp =", **pp)
**pp = 9
print("x =", x)

/* ② 双指针：原地反转列表，不新建列表
list xs = [1, 2, 3, 4, 5]
int i = 0
int j = len(xs) - 1
while i < j
    ptr a = &xs[i]
    ptr b = &xs[j]
    int t = *a
    *a = *b
    *b = t
    i += 1
    j -= 1
print("反转后 =", xs)

/* ③ arena：一次申请一整块池子，用游标切出多个不同大小的对象
/* 每个对象只记自己的起始偏移；最后 free(pool) 整块回收。
ptr pool = alloc(32)
int off = 0

/* 切 n 格：cursor 里存"下一个空位"，返回这一块的起点偏移
fn carve(ptr cursor, int n)
    int at = *cursor
    if at + n > len(pool)
        return -1
    *cursor = at + n
    return at

int a = carve(&off, 3)
pool[a] = 100
pool[a + 1] = 200
pool[a + 2] = 300

int b = carve(&off, 2)
pool[b] = 7
pool[b + 1] = 8

int big = carve(&off, 99)
if big == -1
    print("池子不够了，这块没给")

print("a 在", a, "b 在", b, "光标", off)
print("a 块 =", pool[a], pool[a + 1], pool[a + 2])
print("b 块 =", pool[b], pool[b + 1])
free(pool)

/* ④ 指针当游标：起点不动，p + k 一格一格读
ptr buf = alloc(4)
int m = 0
while m < 4
    buf[m] = (m + 1) * 10
    m += 1
ptr cur = buf
int sum = 0
int n = 0
while n < 4
    sum += *(cur + n)
    n += 1
print("总和 =", sum)
free(buf)
